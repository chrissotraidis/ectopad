+bool SDLBackendSubmix::isDirectDependencyOf(SDLBackendSubmix* send) const {
+  return m_sendGains.find(send) != m_sendGains.cend();
+}
+
+void SDLBackendSubmix::linearizeC3(std::vector<SDLBackendSubmix*>& out) {
+  // Simple iterative C3 merge over the allocator's submix list.
+  out.push_back(this);
+  bool changed = true;
+  while (changed) {
+    changed = false;
+    for (SDLBackendSubmix* smx : m_root.m_submixes) {
+      if (smx == this || std::find(out.begin(), out.end(), smx) != out.end()) {
+        continue;
+      }
+      if (smx->isDirectDependencyOf(this)) {
+        out.push_back(smx);
+        changed = true;
+      }
+    }
+  }
+}
+
+void SDLBackendSubmix::pumpAndMix(size_t frames) {
+  const int chanCount = kChannelCount;
+
+  if (m_redirect) {
+    if (m_clientSmx != nullptr && m_clientSmx->canApplyEffect()) {
+      amuse::ChannelMap chMap;
+      chMap.m_channelCount = 2;
+      chMap.m_channels[0] = amuse::AudioChannel::FrontLeft;
+      chMap.m_channels[1] = amuse::AudioChannel::FrontRight;
+      m_clientSmx->applyEffect(m_redirect, frames, chMap);
+    }
+    m_redirect += chanCount * frames;
+  } else {
+    const size_t sampleCount = frames * chanCount;
+    if (m_scratch.size() < sampleCount) {
+      m_scratch.resize(sampleCount);
+    }
+    if (m_clientSmx != nullptr && m_clientSmx->canApplyEffect()) {
+      amuse::ChannelMap chMap;
+      chMap.m_channelCount = 2;
+      chMap.m_channels[0] = amuse::AudioChannel::FrontLeft;
+      chMap.m_channels[1] = amuse::AudioChannel::FrontRight;
+      m_clientSmx->applyEffect(m_scratch.data(), frames, chMap);
+    }
+
+    for (auto& kv : m_sendGains) {
+      SDLBackendSubmix* sm = kv.first;
+      float* dataOut = sm->getMergeBuf(frames);
+      const bool slewing = m_slewFrames != 0 && m_curSlewFrame < m_slewFrames;
+      for (size_t f = 0; f < sampleCount; ++f) {
+        const float v = m_scratch[f];
+        if (slewing) {
+          const double t = static_cast<double>(m_curSlewFrame) / static_cast<double>(m_slewFrames);
+          const double omt = 1.0 - t;
+          dataOut[f] += v * static_cast<float>(kv.second[1] * t + kv.second[0] * omt);
+        } else {
+          dataOut[f] += v * kv.second[1];
+        }
+      }
+      if (slewing) {
+        ++m_curSlewFrame;
+      }
+    }
+  }
+}
+
+} // namespace metaforce
diff --git a/Runtime/Audio/SDLBackend.hpp b/Runtime/Audio/SDLBackend.hpp
new file mode 100644
index 0000000..caf441a
--- /dev/null
+++ b/Runtime/Audio/SDLBackend.hpp
@@ -0,0 +1,133 @@
+#pragma once
+
+#include <amuse/IBackendSubmix.hpp>
+#include <amuse/IBackendVoice.hpp>
+#include <amuse/IBackendVoiceAllocator.hpp>
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+namespace amuse {
+class Engine;
+class Submix;
+class Voice;
+} // namespace amuse
+
+namespace metaforce {
+
+class SDLBackendVoice;
+class SDLBackendSubmix;
+
+/**
+ * Minimal software mixer backend for amuse, written for the Metaforce Apple
+ * port. Voices are mixed into an interleaved stereo float buffer on the
+ * calling thread (pumpAndMix), which the host feeds to an SDL3 audio device.
+ *
+ * No resampling: every voice must run at the mixer rate (32 kHz for Prime's
+ * audio groups). Deviations are logged and played at the wrong pitch rather
+ * than crashing, so a soxr-based resampler can be added later if needed.
+ */
+class SDLBackendVoiceAllocator : public amuse::IBackendVoiceAllocator {
+  friend class SDLBackendVoice;
+  friend class SDLBackendSubmix;
+
+  amuse::Engine* m_cbInterface = nullptr;
+  double m_mixRate;
+  size_t m_5msFrames;
+  float m_totalVol = 1.f;
+
+  std::recursive_mutex m_lock;
+  std::vector<SDLBackendVoice*> m_voices;
+  std::vector<SDLBackendSubmix*> m_submixes;
+  SDLBackendSubmix* m_mainSubmix = nullptr;
+  bool m_submixesDirty = false;
+  std::vector<SDLBackendSubmix*> m_linearizedSubmixes;
+
+public:
+  explicit SDLBackendVoiceAllocator(double mixRate = 32000.0);
+  ~SDLBackendVoiceAllocator() override;
+
+  std::unique_ptr<amuse::IBackendVoice> allocateVoice(amuse::Voice& clientVox, double sampleRate,
+                                                      bool dynamicPitch) override;
+  std::unique_ptr<amuse::IBackendSubmix> allocateSubmix(amuse::Submix& clientSmx, bool mainOut,
+                                                        int busId) override;
+  std::vector<std::pair<std::string, std::string>> enumerateMIDIDevices() override;
+  std::unique_ptr<amuse::IMIDIReader> allocateMIDIReader(amuse::Engine& engine) override;
+  amuse::AudioChannelSet getAvailableSet() override;
+  void setVolume(float vol) override;
+  void setCallbackInterface(amuse::Engine* engine) override;
+
+  /** Mix up to `frames` stereo frames into dataOut (interleaved float). */
+  void pumpAndMix(size_t frames, float* dataOut);
+};
+
+/** Backend voice: owns the voice's send matrices; mixed by the allocator. */
+class SDLBackendVoice : public amuse::IBackendVoice {
+  friend class SDLBackendVoiceAllocator;
+
+  struct Send {
+    SDLBackendSubmix* smx = nullptr;
+    std::array<float, 8> coefs{};
+    std::array<float, 8> oldCoefs{};
+    int slewFrames = 0;
+    int curSlewFrame = 0;
+  };
+
+  SDLBackendVoiceAllocator& m_root;
+  amuse::Voice& m_clientVox;
+  bool m_running = false;
+  std::unordered_map<SDLBackendSubmix*, Send> m_sends;
+  std::vector<float> m_scratchPre;
+  std::vector<float> m_scratchPost;
+  std::vector<int16_t> m_s16Buf;
+
+public:
+  SDLBackendVoice(SDLBackendVoiceAllocator& root, amuse::Voice& clientVox, double sampleRate, bool dynamicPitch);
+  ~SDLBackendVoice() override;
+
+  void resetSampleRate(double sampleRate) override;
+  void resetChannelLevels() override;
+  void setChannelLevels(amuse::IBackendSubmix* submix, const std::array<float, 8>& coefs, bool slew) override;
+  void setPitchRatio(double ratio, bool slew) override;
+  void start() override;
+  void stop() override;
+
+  void pumpAndMix(size_t frames);
+};
+
+/** Backend submix: accumulates voice contributions, applies effects, sends. */
+class SDLBackendSubmix : public amuse::IBackendSubmix {
+  friend class SDLBackendVoiceAllocator;
+  friend class SDLBackendVoice;
+
+  SDLBackendVoiceAllocator& m_root;
+  amuse::Submix* m_clientSmx;
+  int m_busId;
+  bool m_mainOut;
+  std::unordered_map<SDLBackendSubmix*, std::array<float, 2>> m_sendGains;
+  std::vector<float> m_scratch;
+  float* m_redirect = nullptr;
+  int m_slewFrames = 0;
+  int m_curSlewFrame = 0;
+
+public:
+  SDLBackendSubmix(SDLBackendVoiceAllocator& root, amuse::Submix* clientSmx, bool mainOut, int busId);
+  ~SDLBackendSubmix() override;
+
+  void setSendLevel(amuse::IBackendSubmix* submix, float level, bool slew) override;
+  double getSampleRate() const override;
+  amuse::SubmixFormat getSampleFormat() const override;
+
+  void zeroFill();
+  float* getMergeBuf(size_t frames);
+  void pumpAndMix(size_t frames);
+  bool isDirectDependencyOf(SDLBackendSubmix* send) const;
+  void linearizeC3(std::vector<SDLBackendSubmix*>& out);
+};
+
+} // namespace metaforce

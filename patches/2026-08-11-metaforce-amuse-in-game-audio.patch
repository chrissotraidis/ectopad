+void SDLBackendVoiceAllocator::pumpAndMix(size_t frames, float* dataOut) {
+  std::lock_guard<std::recursive_mutex> lock(m_lock);
+  static uint64_t s_pumpCount = 0;
+  if (++s_pumpCount % 300 == 0) {
+    size_t running = 0;
+    for (const SDLBackendVoice* vox : m_voices) {
+      if (vox->m_running) {
+        ++running;
+      }
+    }
+    if (running > 0 || !m_voices.empty()) {
+      spdlog::info("SDLBackend: {} voices ({} running), {} submixes", m_voices.size(), running, m_submixes.size());
+    }
+  }
+  if (dataOut) {
+    std::memset(dataOut, 0, sizeof(float) * frames * kChannelCount);
+  }
+
+  if (m_submixesDirty) {
+    m_linearizedSubmixes.clear();
+    m_mainSubmix->linearizeC3(m_linearizedSubmixes);
+    m_submixesDirty = false;
+  }
+
+  m_mainSubmix->m_redirect = dataOut;
+
+  size_t remFrames = frames;
+  while (remFrames) {
+    const size_t thisFrames = std::min(remFrames, m_5msFrames);
+    const double dt = static_cast<double>(thisFrames) / static_cast<double>(m_5msFrames) * 5.0 / 1000.0;
+    if (m_cbInterface) {
+      m_cbInterface->_on5MsInterval(*this, dt);
+    }
+
+    for (auto it = m_linearizedSubmixes.rbegin(); it != m_linearizedSubmixes.rend(); ++it) {
+      (*it)->zeroFill();
+    }
+
+    for (SDLBackendVoice* vox : m_voices) {
+      if (vox->m_running) {
+        vox->pumpAndMix(thisFrames);
+      }
+    }
+
+    for (auto it = m_linearizedSubmixes.rbegin(); it != m_linearizedSubmixes.rend(); ++it) {
+      (*it)->pumpAndMix(thisFrames);
+    }
+
+    remFrames -= thisFrames;
+    if (dataOut) {
+      const size_t sampleCount = thisFrames * kChannelCount;
+      for (size_t i = 0; i < sampleCount; ++i) {
+        dataOut[i] *= m_totalVol;
+      }
+      dataOut += sampleCount;
+    }
+  }
+
+  if (m_cbInterface) {
+    m_cbInterface->_onPumpCycleComplete(*this);
+  }
+}

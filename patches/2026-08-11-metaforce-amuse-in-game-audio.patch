+void SDLBackendVoice::pumpAndMix(size_t frames) {
+  if (m_scratchPre.size() < frames + 2) {
+    m_scratchPre.resize(frames + 2);
+  }
+  if (m_scratchPost.size() < frames + 2) {
+    m_scratchPost.resize(frames + 2);
+  }
+  if (m_s16Buf.size() < frames + 2) {
+    m_s16Buf.resize(frames + 2);
+  }
+
+  const double dt = static_cast<double>(frames) / m_root.m_mixRate;
+  m_clientVox.preSupplyAudio(dt);
+
+  const size_t oDone = m_clientVox.supplyAudio(frames, m_s16Buf.data());
+  for (size_t i = 0; i < oDone; ++i) {
+    m_scratchPre[i] = static_cast<float>(m_s16Buf[i]) / 32768.f;
+  }
+
+  if (m_sends.empty()) {
+    // Route to the main output with an identity-ish stereo matrix (FL=FR=1).
+    SDLBackendSubmix& mainSmx = *m_root.m_mainSubmix;
+    m_clientVox.routeAudio(oDone, dt, mainSmx.m_busId, m_scratchPre.data(), m_scratchPost.data());
+    float* out = mainSmx.getMergeBuf(oDone);
+    for (size_t f = 0; f < oDone; ++f) {
+      const float v = m_scratchPost[f];
+      out[f * kChannelCount + 0] += v;
+      out[f * kChannelCount + 1] += v;
+    }
+  } else {
+    for (auto& kv : m_sends) {
+      SDLBackendSubmix* smx = kv.first;
+      Send& send = kv.second;
+      m_clientVox.routeAudio(oDone, dt, smx->m_busId, m_scratchPre.data(), m_scratchPost.data());
+      float* out = smx->getMergeBuf(oDone);
+      const bool slewing = send.slewFrames != 0 && send.curSlewFrame < send.slewFrames;
+      for (size_t f = 0; f < oDone; ++f) {
+        const float v = m_scratchPost[f];
+        float gain[2];
+        if (slewing) {
+          const double t = static_cast<double>(send.curSlewFrame) / static_cast<double>(send.slewFrames);
+          const double omt = 1.0 - t;
+          gain[0] = static_cast<float>(send.coefs[0] * t + send.oldCoefs[0] * omt);
+          gain[1] = static_cast<float>(send.coefs[1] * t + send.oldCoefs[1] * omt);
+        } else {
+          gain[0] = send.coefs[0];
+          gain[1] = send.coefs[1];
+        }
+        out[f * kChannelCount + 0] += v * gain[0];
+        out[f * kChannelCount + 1] += v * gain[1];
+      }
+      if (slewing) {
+        ++send.curSlewFrame;
+      }
+    }
+  }
+}

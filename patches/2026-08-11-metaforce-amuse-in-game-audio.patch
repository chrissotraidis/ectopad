+
+float* SDLBackendSubmix::getMergeBuf(size_t frames) {
+  if (m_redirect) {
+    return m_redirect;
+  }
+  const size_t sampleCount = frames * kChannelCount;
+  if (m_scratch.size() < sampleCount) {
+    m_scratch.resize(sampleCount);
+  }
+  return m_scratch.data();
+}

+amuse::Engine* CAudioSys::s_amuseEngine = nullptr;
+
+namespace {
+void MasterSupplyCallback(float* data, int frames) {
+  // Frontend/static music first.
+  CStaticAudioPlayer::SupplyCallback(data, frames);
+  // Then the amuse engine mix (game SFX/music), summed on top.
+  if (SDLBackendVoiceAllocator* backend = CAudioSys::GetAudioBackendPtr()) {
+    static std::vector<float> amuseBuf;
+    amuseBuf.resize(static_cast<size_t>(frames) * 2);
+    backend->pumpAndMix(static_cast<size_t>(frames), amuseBuf.data());
+    for (int i = 0; i < frames * 2; ++i) {
+      data[i] += amuseBuf[i];
+    }
+  }
+}
+} // namespace
+
+amuse::Engine& CAudioSys::GetAmuseEngine() {
+  if (s_amuseEngine == nullptr) {
+    AudioSysInit();
+  }
+  return *s_amuseEngine;
+}
+
+SDLBackendVoiceAllocator& CAudioSys::GetAudioBackend() {
+  GetAmuseEngine();
+  return *s_audioBackend;
+}
+
+SDLBackendVoiceAllocator* CAudioSys::GetAudioBackendPtr() { return s_audioBackend; }
+
+void CAudioSys::AudioSysInit() {
+  if (s_amuseEngine != nullptr) {
+    return;
+  }
+  s_audioBackend = new SDLBackendVoiceAllocator(32000.0);
+  s_amuseEngine = new amuse::Engine(*s_audioBackend);
+  aurora_audio_open(32000, MasterSupplyCallback);
+  spdlog::info("CAudioSys: amuse engine initialized (SDL backend, 32000 Hz)");
+}
+
+void CAudioSys::AudioSysShutdown() {
+  delete s_amuseEngine;
+  s_amuseEngine = nullptr;
+  delete s_audioBackend;
+  s_audioBackend = nullptr;
+}
 

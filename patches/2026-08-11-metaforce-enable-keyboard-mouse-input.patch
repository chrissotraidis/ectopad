+    case SDLK_DOWN: return ESpecialKey::Down;
+    case SDLK_LEFT: return ESpecialKey::Left;
+    case SDLK_RIGHT: return ESpecialKey::Right;
+    case SDLK_RETURN: case SDLK_KP_ENTER: return ESpecialKey::Enter;
+    case SDLK_ESCAPE: return ESpecialKey::Esc;
+    case SDLK_BACKSPACE: return ESpecialKey::Backspace;
+    case SDLK_TAB: return ESpecialKey::Tab;
+    case SDLK_INSERT: return ESpecialKey::Insert;
+    case SDLK_DELETE: return ESpecialKey::Delete;
+    case SDLK_HOME: return ESpecialKey::Home;
+    case SDLK_END: return ESpecialKey::End;
+    case SDLK_PAGEUP: return ESpecialKey::PgUp;
+    case SDLK_PAGEDOWN: return ESpecialKey::PgDown;
+    default:
+      if (key >= SDLK_F1 && key <= SDLK_F24) {
+        return static_cast<ESpecialKey>(static_cast<int>(ESpecialKey::F1) + (key - SDLK_F1));
+      }
+      return ESpecialKey::None;
+    }
+  }
 

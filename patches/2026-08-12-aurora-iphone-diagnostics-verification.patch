+extern "C" int MetaforceRunDiagnosticsPrivacyTest(void) {
+  SunPadDiagnosticsStart();
+  NSString* home = NSHomeDirectory();
+  NSString* temporary = NSTemporaryDirectory();
+  SunPadLog(@"diagnostics privacy test home=%@ temporary=%@", home, temporary);
+
+  NSError* error = nil;
+  NSURL* snapshot = SunPadDiagnosticsSnapshotURL(&error);
+  if (snapshot == nil) {
+    NSLog(@"[SunPad] diagnostics privacy test result=1 error=%@", error.localizedDescription);
+    return 1;
+  }
+  NSString* contents = [NSString stringWithContentsOfURL:snapshot
+                                                encoding:NSUTF8StringEncoding
+                                                   error:&error];
+  const BOOL redacted = contents != nil &&
+      [contents containsString:@"<app-container>"] &&
+      [contents containsString:@"<temporary>/"] &&
+      ![contents containsString:home] &&
+      ![contents containsString:temporary] &&
+      [snapshot.lastPathComponent hasPrefix:@"Metaforce-Diagnostic-"];
+  [NSFileManager.defaultManager removeItemAtURL:snapshot error:nil];
+  NSLog(@"[SunPad] diagnostics privacy test result=%d redaction=%@ snapshotName=%@",
+        redacted ? 0 : 2, redacted ? @"verified" : @"failed", snapshot.lastPathComponent);
+  return redacted ? 0 : 2;
+}
+
 } // namespace aurora::touch

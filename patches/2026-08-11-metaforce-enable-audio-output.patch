diff --git a/include/aurora/audio.h b/include/aurora/audio.h
new file mode 100644
index 0000000..aa21b1c
--- /dev/null
+++ b/include/aurora/audio.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * Minimal SDL3-backed audio output device for Metaforce.
+ *
+ * The host supplies interleaved stereo float samples (sample rate set at open
+ * time, default 32000 Hz) via the supply callback. The callback is invoked
+ * from the main thread inside aurora_audio_pump(), once per frame.
+ */
+typedef void (*AuroraAudioSupplyCallback)(float* data, int frames);
+
+/** Opens the default audio device. Returns false on failure. */
+bool aurora_audio_open(int sampleRate, AuroraAudioSupplyCallback cb);
+
+/** Feeds the device with audio; call once per frame from the main thread. */
+void aurora_audio_pump(void);
+
+/** Closes the audio device (idempotent). */
+void aurora_audio_close(void);
+
+/** True if the device is currently open. */
+bool aurora_audio_is_open(void);
+
+/** Convenience: silence a buffer (used by hosts that have nothing to play). */
+void aurora_audio_fill_silence(float* data, int frames);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/lib/audio.cpp b/lib/audio.cpp
new file mode 100644
index 0000000..f6e7c7f
--- /dev/null
+++ b/lib/audio.cpp
@@ -0,0 +1,124 @@
+#include <aurora/audio.h>
+
+#include <SDL3/SDL.h>
+#include <SDL3/SDL_audio.h>
+
+#include "logging.hpp"
+
+#include <atomic>
+#include <cstring>
+#include <vector>
+
+namespace {
+aurora::Module Log("aurora::audio");
+
+SDL_AudioDeviceID g_device = 0;
+SDL_AudioStream* g_stream = nullptr;
+AuroraAudioSupplyCallback g_cb = nullptr;
+std::atomic<bool> g_running{false};
+int g_sampleRate = 32000;
+bool g_initialFill = true;
+uint64_t g_pumpCount = 0;
+} // namespace
+
+bool aurora_audio_open(int sampleRate, AuroraAudioSupplyCallback cb) {
+  if (g_running.exchange(true, std::memory_order_acq_rel)) {
+    return true;
+  }
+  if (!SDL_InitSubSystem(SDL_INIT_AUDIO)) {
+    Log.error("SDL_InitSubSystem(SDL_INIT_AUDIO) failed: {}", SDL_GetError());
+    g_running.store(false, std::memory_order_release);
+    return false;
+  }
+  g_sampleRate = sampleRate > 0 ? sampleRate : 32000;
+  const SDL_AudioSpec spec{
+      .format = SDL_AUDIO_F32,
+      .channels = 2,
+      .freq = g_sampleRate,
+  };
+  g_device = SDL_OpenAudioDevice(SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec);
+  if (g_device == 0) {
+    Log.error("SDL_OpenAudioDevice failed: {}", SDL_GetError());
+    SDL_QuitSubSystem(SDL_INIT_AUDIO);
+    g_running.store(false, std::memory_order_release);
+    return false;
+  }
+  SDL_AudioSpec actual{};
+  int sampleFrames = 0;
+  if (SDL_GetAudioDeviceFormat(g_device, &actual, &sampleFrames)) {
+    Log.info("Audio device opened: format={} channels={} freq={} sampleFrames={}",
+             static_cast<int>(actual.format), actual.channels, actual.freq, sampleFrames);
+  } else {
+    Log.warn("Audio device opened but SDL_GetAudioDeviceFormat failed: {}", SDL_GetError());
+  }
+  // src = the format we push via SDL_PutAudioStreamData (F32 stereo).
+  // dst = nullptr; binding to the device sets the output format, and SDL
+  // converts between the two automatically.
+  g_stream = SDL_CreateAudioStream(&spec, nullptr);
+  if (g_stream == nullptr || !SDL_BindAudioStream(g_device, g_stream)) {
+    Log.error("SDL audio stream create/bind failed: {}", SDL_GetError());
+    if (g_stream != nullptr) {
+      SDL_DestroyAudioStream(g_stream);
+    }
+    SDL_CloseAudioDevice(g_device);
+    g_device = 0;
+    SDL_QuitSubSystem(SDL_INIT_AUDIO);
+    g_running.store(false, std::memory_order_release);
+    return false;
+  }
+  g_cb = cb;
+  g_initialFill = true;
+  g_pumpCount = 0;
+  Log.info("aurora_audio_open: sampleRate={}", g_sampleRate);
+  return true;
+}
+
+void aurora_audio_pump(void) {
+  if (!g_running.load(std::memory_order_acquire) || g_cb == nullptr || g_stream == nullptr) {
+    return;
+  }
+  // Steady state: supply one 60 Hz frame's worth of audio per pump (fractional
+  // accumulator keeps the long-run average exactly sampleRate/60). On the
+  // first call, burst extra frames so the device does not underrun at startup.
+  static double s_frameAccum = 0.0;
+  s_frameAccum += static_cast<double>(g_sampleRate) / 60.0;
+  int frames = static_cast<int>(s_frameAccum);
+  s_frameAccum -= frames;
+  if (g_initialFill) {
+    frames += g_sampleRate / 20;
+    g_initialFill = false;
+  }
+  static std::vector<float> buf;
+  buf.resize(static_cast<size_t>(frames) * 2);
+  g_cb(buf.data(), frames);
+  if (!SDL_PutAudioStreamData(g_stream, buf.data(), static_cast<int>(buf.size() * sizeof(float)))) {
+    Log.warn("SDL_PutAudioStreamData failed: {}", SDL_GetError());
+  }
+  if (++g_pumpCount % 300 == 0) {
+    Log.info("Audio pump: {} frames supplied, stream available bytes={}",
+             frames, SDL_GetAudioStreamAvailable(g_stream));
+  }
+}
+
+void aurora_audio_close(void) {
+  if (!g_running.exchange(false, std::memory_order_acq_rel)) {
+    return;
+  }
+  if (g_stream != nullptr) {
+    SDL_UnbindAudioStream(g_stream);
+    SDL_DestroyAudioStream(g_stream);
+    g_stream = nullptr;
+  }
+  if (g_device != 0) {
+    SDL_CloseAudioDevice(g_device);
+    g_device = 0;
+  }
+  g_cb = nullptr;
+  SDL_QuitSubSystem(SDL_INIT_AUDIO);
+}
+
+bool aurora_audio_is_open(void) { return g_running.load(std::memory_order_acquire) && g_device != 0; }
+
+void aurora_audio_fill_silence(float* data, int frames) {
+  std::memset(data, 0, static_cast<size_t>(frames) * 2 * sizeof(float));
+}

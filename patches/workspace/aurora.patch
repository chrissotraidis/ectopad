+
+void reconcile_controllers(const char* reason) noexcept {
+  int currentCount = 0;
+  SDL_JoystickID* currentIds = SDL_GetGamepads(&currentCount);
+  if (currentIds == nullptr) {
+    Log.warn("Controller reconciliation '{}' could not enumerate SDL gamepads: {}", reason, SDL_GetError());
+    return;
+  }
+  std::vector<SDL_JoystickID> enumerated(currentIds, currentIds + currentCount);
+  SDL_free(currentIds);
+
+  absl::flat_hash_map<Uint32, Sint32> preservedSlots;
+  std::vector<Uint32> staleInstances;
+  for (const auto& [instance, controller] : g_GameControllers) {
+    const bool enumeratedNow = std::ranges::find(enumerated, instance) != enumerated.end();
+    if (!enumeratedNow || !SDL_GamepadConnected(controller.m_controller)) {
+      staleInstances.push_back(instance);
+      continue;
+    }
+    preservedSlots[instance] = SDL_GetGamepadPlayerIndex(controller.m_controller);
+  }
+  for (const Uint32 instance : staleInstances) {
+    close_controller(instance, reason);
+  }
+
+  for (const SDL_JoystickID instance : enumerated) {
+    if (!g_GameControllers.contains(instance)) {
+      open_controller(instance);
+    }
+  }
+
+  apply_port_preferences();
+
+  std::vector<ControllerSlotSnapshot> snapshots;
+  snapshots.reserve(g_GameControllers.size());
+  for (const auto& [instance, controller] : g_GameControllers) {
+    const auto preserved = preservedSlots.find(instance);
+    snapshots.push_back({
+        .instance = instance,
+        .playerSlot =
+            preserved != preservedSlots.end() ? preserved->second : SDL_GetGamepadPlayerIndex(controller.m_controller),
+        .connected = SDL_GamepadConnected(controller.m_controller),
+        .enumerated = std::ranges::find(enumerated, instance) != enumerated.end(),
+        .preserveSlot = preserved != preservedSlots.end(),
+    });
+  }
+
+  const auto decisions = plan_controller_slots(snapshots, PAD_MAX_CONTROLLERS);
+  bool changed = !staleInstances.empty();
+  for (const auto& decision : decisions) {
+    if (decision.remove && g_GameControllers.contains(decision.instance)) {
+      close_controller(decision.instance, reason);
+      changed = true;
+    }
+  }
+  for (const auto& decision : decisions) {
+    const auto it = g_GameControllers.find(decision.instance);
+    if (it == g_GameControllers.end() || decision.remove) {
+      continue;
+    }
+    const int32_t oldSlot = SDL_GetGamepadPlayerIndex(it->second.m_controller);
+    if (oldSlot != decision.playerSlot) {
+      SDL_SetGamepadPlayerIndex(it->second.m_controller, decision.playerSlot);
+      Log.info("Controller slot reconciliation '{}' instance {} player {} -> {}", reason, decision.instance, oldSlot,
+               decision.playerSlot);
+      changed = true;
+    }
   }
+  if (changed || std::string_view(reason) == "foreground-resume") {
+    Log.info("Controller reconciliation '{}' complete: SDL current {}, tracked {}", reason, currentCount,
+             g_GameControllers.size());
+  }
+  // Connect, disconnect, foreground return and slot changes all pass here.
+  touch::ios_controllers_changed();
 }
 

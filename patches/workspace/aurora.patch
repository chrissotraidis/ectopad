+#import <AVFAudio/AVFAudio.h>
+
+#import "SunPadDiagnostics.h"
+
+extern "C" bool EctoPadActivateAudioSession(void) {
+    AVAudioSession *session = AVAudioSession.sharedInstance;
+    NSError *error = nil;
+    if (![session setCategory:AVAudioSessionCategoryPlayback
+                         mode:AVAudioSessionModeDefault
+                      options:0
+                        error:&error]) {
+        SunPadLog(@"audio session category failed error=%@", error.localizedDescription);
+        return false;
+    }
+    [session setPreferredSampleRate:32000.0 error:&error];
+    if (error != nil) {
+        SunPadLog(@"audio session preferred rate failed error=%@", error.localizedDescription);
+        error = nil;
+    }
+    [session setPreferredIOBufferDuration:0.010 error:&error];
+    if (error != nil) {
+        SunPadLog(@"audio session preferred buffer failed error=%@", error.localizedDescription);
+        error = nil;
+    }
+    if (![session setActive:YES error:&error]) {
+        SunPadLog(@"audio session activation failed error=%@", error.localizedDescription);
+        return false;
+    }
+    NSString *route = session.currentRoute.outputs.firstObject.portType ?: @"none";
+    SunPadLog(@"audio session active route=%@ rate=%.0f ioBufferMs=%.2f channels=%ld",
+              route, session.sampleRate, session.IOBufferDuration * 1000.0,
+              (long)session.outputNumberOfChannels);
+    return true;
+}
+
+extern "C" void EctoPadLogAudioPump(int suppliedFrames, int availableFrames,

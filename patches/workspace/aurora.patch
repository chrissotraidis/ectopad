diff --git a/tests/controller_slots_test.cpp b/tests/controller_slots_test.cpp
new file mode 100644
index 0000000..b2f30ab
--- /dev/null
+++ b/tests/controller_slots_test.cpp
@@ -0,0 +1,78 @@
+#include "../lib/controller_slots.hpp"
+
+#include <gtest/gtest.h>
+
+#include <algorithm>
+
+namespace aurora::input {
+namespace {
+
+const ControllerSlotDecision& decision_for(const std::vector<ControllerSlotDecision>& decisions,
+                                           const uint32_t instance) {
+  return *std::ranges::find(decisions, instance, &ControllerSlotDecision::instance);
+}
+
+TEST(ControllerSlots, MissedRemovalReleasesStaleSlotAndReturningControllerReclaimsPlayerOne) {
+  const auto decisions = plan_controller_slots(
+      {
+          {.instance = 10, .playerSlot = 0, .connected = false, .enumerated = false, .preserveSlot = true},
+          {.instance = 20, .playerSlot = 1, .connected = true, .enumerated = true, .preserveSlot = false},
+      },
+      4);
+
+  EXPECT_TRUE(decision_for(decisions, 10).remove);
+  EXPECT_EQ(decision_for(decisions, 10).playerSlot, -1);
+  EXPECT_FALSE(decision_for(decisions, 20).remove);
+  EXPECT_EQ(decision_for(decisions, 20).playerSlot, 0);
+}
+
+TEST(ControllerSlots, TwoConnectedControllersKeepTheirExistingSlots) {
+  const auto decisions = plan_controller_slots(
+      {
+          {.instance = 20, .playerSlot = 1, .connected = true, .enumerated = true, .preserveSlot = true},
+          {.instance = 10, .playerSlot = 0, .connected = true, .enumerated = true, .preserveSlot = true},
+      },
+      4);
+
+  EXPECT_EQ(decision_for(decisions, 10).playerSlot, 0);
+  EXPECT_EQ(decision_for(decisions, 20).playerSlot, 1);
+}
+
+TEST(ControllerSlots, RemainingConnectedControllerKeepsItsExistingSlot) {
+  const auto decisions = plan_controller_slots(
+      {
+          {.instance = 20, .playerSlot = 1, .connected = true, .enumerated = true, .preserveSlot = true},
+      },
+      4);
+
+  EXPECT_EQ(decision_for(decisions, 20).playerSlot, 1);
+}
+
+TEST(ControllerSlots, AdditionalControllerUsesNextFreeSlotWithoutDisplacingPlayerOne) {
+  const auto decisions = plan_controller_slots(
+      {
+          {.instance = 10, .playerSlot = 0, .connected = true, .enumerated = true, .preserveSlot = true},
+          {.instance = 20, .playerSlot = 0, .connected = true, .enumerated = true, .preserveSlot = false},
+      },
+      4);
+
+  EXPECT_EQ(decision_for(decisions, 10).playerSlot, 0);
+  EXPECT_EQ(decision_for(decisions, 20).playerSlot, 1);
+}
+
+TEST(ControllerSlots, ForegroundResumeDropsUnenumeratedHandleAndPreservesLivePlayers) {
+  const auto decisions = plan_controller_slots(
+      {
+          {.instance = 30, .playerSlot = 2, .connected = true, .enumerated = false, .preserveSlot = true},
+          {.instance = 10, .playerSlot = 0, .connected = true, .enumerated = true, .preserveSlot = true},
+          {.instance = 20, .playerSlot = 1, .connected = true, .enumerated = true, .preserveSlot = true},
+      },
+      4);
+
+  EXPECT_TRUE(decision_for(decisions, 30).remove);
+  EXPECT_EQ(decision_for(decisions, 10).playerSlot, 0);
+  EXPECT_EQ(decision_for(decisions, 20).playerSlot, 1);
+}
+
+} // namespace
+} // namespace aurora::input
diff --git a/tests/gx_fifo_test.cpp b/tests/gx_fifo_test.cpp

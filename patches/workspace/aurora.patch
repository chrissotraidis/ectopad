+bool attach_ios_overlay(SDL_Window* sdlWindow) noexcept {
+  if (g_overlay != nil) {
+    return true;
+  }
+  if (sdlWindow == nullptr) {
+    NSLog(@"[SunPad] attach: null SDL window");
+    return false;
+  }
+  void* windowPtr =
+      SDL_GetPointerProperty(SDL_GetWindowProperties(sdlWindow), SDL_PROP_WINDOW_UIKIT_WINDOW_POINTER, nullptr);
+  if (windowPtr == nullptr) {
+    NSLog(@"[SunPad] attach: no UIKIT window property");
+    return false;
+  }
+  UIWindow* window = (__bridge UIWindow*)windowPtr;
+  SunPadDiagnosticsStart();
+
+  // SunPad owns its overlay from the active game view controller. UIKit's
+  // native UIButton/UIMenu presentation also requires that controller-owned
+  // hierarchy; a window-level sibling can draw and receive touches while its
+  // context menu silently fails to present under SDL's UIKit host.
+  UIView* hostView = window.rootViewController.view ?: window;
+  SunPadGameOverlay* overlay = [[SunPadGameOverlay alloc] initWithFrame:hostView.bounds];
+  overlay.autoresizingMask = UIViewAutoresizingFlexibleWidth | UIViewAutoresizingFlexibleHeight;
+  g_delegate = [TouchOverlayDelegate new];
+  g_delegate.overlay = overlay;
+  overlay.delegate = g_delegate;
+  [hostView addSubview:overlay];
+  g_overlay = overlay;
+  // A controller already connected before launch: evaluate player 1 now.
+  ios_controllers_changed();
+  PublishControllerMapping(CurrentControllerMapping());
+  [g_delegate applyEngineSettings];
+  if (ProcessHasArgument(@"--metaforce-controller-mapping-ui-test")) {
+    dispatch_async(dispatch_get_main_queue(), ^{
+      [g_delegate presentControllerMapping:g_overlay];
+      SunPadLog(@"controller mapping UI test presented");
+    });
+  }
+  if (ProcessHasArgument(@"--metaforce-sunpad-interaction-test")) {
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.75 * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+      run_interaction_test();
+    });
+  }
+  if (ProcessHasArgument(@"--metaforce-diagnostics-confirmation-ui-test")) {
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+      [g_overlay shareDiagnosticLog];
+      SunPadLog(@"diagnostic confirmation UI test presented");
+    });
+  } else if (ProcessHasArgument(@"--metaforce-diagnostics-share-ui-test")) {
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+      [g_overlay presentDiagnosticLogShareSheet];
+      SunPadLog(@"diagnostic share UI test presented");
+    });
+  }
+
+  g_fpsLabel = [UILabel new];
+  g_fpsLabel.textColor = [UIColor colorWithWhite:1.0 alpha:0.85];
+  g_fpsLabel.font = [UIFont monospacedDigitSystemFontOfSize:12.0 weight:UIFontWeightSemibold];
+  g_fpsLabel.hidden = YES;
+  g_fpsLabel.userInteractionEnabled = NO;
+  [hostView addSubview:g_fpsLabel];
+  update_fps_label();
+  g_fpsTimer = [NSTimer scheduledTimerWithTimeInterval:1.0
+                                               repeats:YES
+                                                 block:^(NSTimer*) {
+    update_fps_label();
+  }];
+
+  return true;
+}
+
+void ios_controllers_changed() noexcept {
+  dispatch_async(dispatch_get_main_queue(), ^{
+    if (g_overlay == nil) {
+      return;
+    }
+#if TARGET_OS_SIMULATOR
+    // The Simulator presents the Mac keyboard as a controller; keep touch there.
+    g_overlay.touchPlayerHasController = NO;
+#else
+    g_overlay.touchPlayerHasController = touch_player_has_usable_controller();
+#endif
+  });
+}

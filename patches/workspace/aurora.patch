+    if (ProcessHasArgument(@"--metaforce-controller-mapping-pad-test"))
+        mapping = SunPadControllerButtonMappingByAssigning(
+            mapping, SunPadPhysicalControllerButtonB, SunPadButtonA);
+    return mapping;
+}
+
+static std::atomic_uint64_t g_controllerMappingBits{0};
+
+static uint64_t PackControllerMapping(SunPadControllerButtonMapping mapping) {
+    return (uint64_t)mapping.gameA | ((uint64_t)mapping.gameB << 8) |
+        ((uint64_t)mapping.gameX << 16) | ((uint64_t)mapping.gameY << 24) |
+        ((uint64_t)mapping.gameZ << 32);
+}
+
+static SunPadControllerButtonMapping UnpackControllerMapping(uint64_t bits) {
+    return (SunPadControllerButtonMapping){
+        .gameA = (SunPadPhysicalControllerButton)(bits & 0xff),
+        .gameB = (SunPadPhysicalControllerButton)((bits >> 8) & 0xff),
+        .gameX = (SunPadPhysicalControllerButton)((bits >> 16) & 0xff),
+        .gameY = (SunPadPhysicalControllerButton)((bits >> 24) & 0xff),
+        .gameZ = (SunPadPhysicalControllerButton)((bits >> 32) & 0xff),
+    };
+}
+
+static void PublishControllerMapping(SunPadControllerButtonMapping mapping) {
+    g_controllerMappingBits.store(PackControllerMapping(mapping), std::memory_order_release);
+}
+
+static SunPadControllerButtonMapping ActiveControllerMapping(void) {
+    uint64_t bits = g_controllerMappingBits.load(std::memory_order_acquire);
+    if (bits == 0) {
+        SunPadControllerButtonMapping mapping = CurrentControllerMapping();
+        bits = PackControllerMapping(mapping);
+        g_controllerMappingBits.store(bits, std::memory_order_release);
+    }
+    return UnpackControllerMapping(bits);
+}

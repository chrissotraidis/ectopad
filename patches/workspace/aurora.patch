+void run_interaction_test() {
+  NSArray<NSString*>* defaultsKeys = @[
+    @"SunPadRenderScale", @"SunPadControlOpacity", @"SunPadControlSizeScale",
+    @"SunPadHideControlsOnController", @"SunPadModernCStickHorizontal",
+    @"SunPadControlOrigins", @"SunPadControlSizeScales",
+    @"SunPadExperimentalDPadOrigin", @"SunPadExperimentalDPadScale",
+  ];
+  NSDictionary<NSString*, id>* savedDefaults = SaveDefaults(defaultsKeys);
+  __block int result = 0;
+
+  UIButton* menuButton = (UIButton*)FindView(g_overlay, @"Menu", nil);
+  NSMutableSet<NSString*>* menuTitles = [NSMutableSet set];
+  if ([menuButton isKindOfClass:UIButton.class] && menuButton.menu != nil)
+    CollectMenuTitles(menuButton.menu, menuTitles);
+  NSSet<NSString*>* expectedMenuTitles = [NSSet setWithArray:@[
+    @"EctoPad", @"Display", @"Render Resolution", @"Aspect Ratio", @"Show FPS Counter",
+    @"Controls", @"Controller Button Mapping…", @"Touch Control Settings…", @"Game Data & Saves",
+    @"Change or Reimport Game Data", @"Import from EctoPad Folder",
+    @"Remove Stored Game Data", @"Report a Problem…",
+  ]];
+  if (menuButton == nil || ![expectedMenuTitles isSubsetOfSet:menuTitles])
+    result |= 1;
+  if (@available(iOS 15.0, *)) {
+    if (menuButton.configuration == nil ||
+        menuButton.configuration.image.renderingMode != UIImageRenderingModeAlwaysOriginal ||
+        menuButton.automaticallyUpdatesConfiguration ||
+        menuButton.layer.borderWidth != 0.0)
+      result |= 1;
+  }
+
+  NSArray<NSString*>* controlIdentifiers = @[
+    @"move", @"c", @"A", @"B", @"X", @"Y", @"Z", @"Start", @"L", @"R",
+    @"D_U", @"D_D", @"D_L", @"D_R",
+  ];
+  for (NSString* identifier in controlIdentifiers) {
+    if (FindView(g_overlay, nil, identifier) == nil)
+      result |= 2;
+  }
+
+  UIControl* aButton = (UIControl*)FindView(g_overlay, @"A", @"A");
+  if (![aButton isKindOfClass:UIControl.class]) {
+    result |= 4;
+  } else {
+    [aButton sendActionsForControlEvents:UIControlEventTouchDown];
+    SunPadInputState pressed = [SunPadInputMixer.sharedMixer consumeMergedState];
+    [aButton sendActionsForControlEvents:UIControlEventTouchUpInside];
+    SunPadInputState released = [SunPadInputMixer.sharedMixer consumeMergedState];
+    if (!pressed.connected || !(pressed.buttons & SunPadButtonA) ||
+        (released.buttons & SunPadButtonA))
+      result |= 4;
+  }
+
+  [g_overlay toggleSettingsPanel];
+  UISegmentedControl* render =
+      (UISegmentedControl*)FindView(g_overlay, @"Render resolution", nil);
+  UISlider* opacity = (UISlider*)FindView(g_overlay, @"Control opacity", nil);
+  UISlider* allSizes = (UISlider*)FindView(g_overlay, @"Control size", nil);
+  UISwitch* hide =
+      (UISwitch*)FindView(g_overlay, @"Auto-hide Touch Controls with Controller", nil);
+  if (![render isKindOfClass:UISegmentedControl.class] ||
+      ![opacity isKindOfClass:UISlider.class] ||
+      ![allSizes isKindOfClass:UISlider.class] ||
+      ![hide isKindOfClass:UISwitch.class]) {
+    result |= 8;
+  } else {
+    render.selectedSegmentIndex = 1;
+    [render sendActionsForControlEvents:UIControlEventValueChanged];
+    opacity.value = 0.63f;
+    [opacity sendActionsForControlEvents:UIControlEventValueChanged];
+    allSizes.value = 1.12f;
+    [allSizes sendActionsForControlEvents:UIControlEventValueChanged];
+    hide.on = !hide.on;
+    [hide sendActionsForControlEvents:UIControlEventValueChanged];
+    SunPadSettings* settings = SunPadSettings.sharedSettings;
+    if (settings.renderScale != 2 || std::abs(settings.controlOpacity - 0.63) > 0.01 ||
+        std::abs(settings.controlSizeScale - 1.12) > 0.01 ||
+        settings.hideTouchControlsWhenControllerConnected != hide.on)
+      result |= 8;
+  }
+  [g_overlay setNeedsLayout];
+  [g_overlay layoutIfNeeded];
+  NSLog(@"[SunPad] interaction test phase=settings result=%d menu=%lu controls=%lu",
+        result, (unsigned long)menuTitles.count, (unsigned long)controlIdentifiers.count);
+
+  dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.5 * NSEC_PER_SEC)),
+                 dispatch_get_main_queue(), ^{
+    [g_overlay beginLayoutEditing];
+    UIView* editableA = FindView(g_overlay, @"A", @"A");
+    [g_overlay selectControlForEditing:editableA];
+    UISlider* selected = (UISlider*)FindViewOfClass(
+        g_overlay, UISlider.class, @"A size", nil);
+    if (![selected isKindOfClass:UISlider.class] || !selected.enabled) {
+      result |= 16;
+    } else {
+      NSArray<NSString*>* actions =
+          [selected actionsForTarget:g_overlay forControlEvent:UIControlEventValueChanged];
+      selected.value = 1.25f;
+      [selected sendAction:@selector(selectedSizeChanged:) to:g_overlay forEvent:nil];
+      if (![actions containsObject:@"selectedSizeChanged:"] ||
+          std::abs([SunPadSettings.sharedSettings sizeScaleForControl:@"A"] - 1.25) > 0.01)
+        result |= 16;
+    }
+    [g_overlay setNeedsLayout];
+    [g_overlay layoutIfNeeded];
+    NSLog(@"[SunPad] interaction test phase=editor result=%d selected=%@ size=%.2f",
+          result, selected.accessibilityLabel,
+          [SunPadSettings.sharedSettings sizeScaleForControl:@"A"]);
+
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.5 * NSEC_PER_SEC)),
+                   dispatch_get_main_queue(), ^{
+      [g_overlay resetLayout];
+      if (std::abs([SunPadSettings.sharedSettings sizeScaleForControl:@"A"] - 1.0) > 0.01 ||
+          [NSUserDefaults.standardUserDefaults objectForKey:@"SunPadControlOrigins"] != nil ||
+          [NSUserDefaults.standardUserDefaults objectForKey:@"SunPadExperimentalDPadOrigin"] != nil)
+        result |= 32;
+      [g_overlay finishLayoutEditing];
+
+      UIViewController* presenter = g_overlay.window.rootViewController;
+      if (MetaforceGameDataImagesInDocumentsDirectory().count != 0) {
+        result |= 64;
+        NSLog(@"[SunPad] interaction test folder phase skipped: candidate game data present");
+      } else {
+        [g_delegate gameOverlayRequestsGameDataFolderImport:g_overlay];
+        UIAlertController* folder =
+            [presenter.presentedViewController isKindOfClass:UIAlertController.class]
+                ? (UIAlertController*)presenter.presentedViewController : nil;
+        if (![folder.title isEqualToString:@"Metaforce Folder"] ||
+            ![folder.message containsString:@"No ISO or GCM was found"])
+          result |= 64;
+        NSLog(@"[SunPad] interaction test phase=folder result=%d title=%@",
+              result, folder.title);
+      }
+
+      dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.5 * NSEC_PER_SEC)),
+                     dispatch_get_main_queue(), ^{
+        [presenter dismissViewControllerAnimated:NO completion:^{
+          [g_delegate gameOverlayRequestsGameDataChange:g_overlay];
+          /* A cold UIDocumentPicker launch starts DocumentManager out of
+           * process; wait long enough for its presentation transition. */
+          dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.0 * NSEC_PER_SEC)),
+                         dispatch_get_main_queue(), ^{
+            UIViewController* picker = presenter.presentedViewController;
+            if (![picker isKindOfClass:UIDocumentPickerViewController.class] ||
+                ((UIDocumentPickerViewController*)picker).delegate != g_delegate)
+              result |= 128;
+            NSLog(@"[SunPad] interaction test phase=files-picker result=%d class=%@ delegate=%@",
+                  result, NSStringFromClass(picker.class),
+                  [picker isKindOfClass:UIDocumentPickerViewController.class]
+                      ? NSStringFromClass(((UIDocumentPickerViewController*)picker).delegate.class)
+                      : @"none");
+
+            dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(2.5 * NSEC_PER_SEC)),
+                           dispatch_get_main_queue(), ^{
+              [presenter dismissViewControllerAnimated:NO completion:^{
+                RestoreDefaults(savedDefaults);
+                [g_overlay applySettings];
+                [SunPadInputMixer.sharedMixer clearInputFromTouch:YES];
+                NSLog(@"[SunPad] interaction test result=%d restored=verified", result);
+              }];
+            });
+          });
+        }];
+      });
+    });
+  });
+}
+
+void update_fps_label() {
+  static uint64_t previousFrames = 0;
+  static CFAbsoluteTime previousTime = 0;
+  const uint64_t frames = g_presentedFrames.load(std::memory_order_relaxed);
+  const CFAbsoluteTime now = CFAbsoluteTimeGetCurrent();
+  if (previousTime > 0 && now > previousTime) {
+    const double fps = static_cast<double>(frames - previousFrames) / (now - previousTime);
+    if ([SunPadSettings sharedSettings].showFPSCounter && fps > 0.0) {
+      g_fpsLabel.text = [NSString stringWithFormat:@"%.1f FPS", fps];
+      g_fpsLabel.hidden = NO;
+    } else {
+      g_fpsLabel.hidden = YES;
+    }
+  }
+  previousFrames = frames;
+  previousTime = now;
+
+  UIWindow* window = g_overlay.window;
+  if (window != nil) {
+    CGRect safe = UIEdgeInsetsInsetRect(window.bounds, window.safeAreaInsets);
+    g_fpsLabel.frame = CGRectMake(CGRectGetMinX(safe) + 8.0,
+                                  CGRectGetMinY(safe) + 8.0, 140.0, 22.0);
+  }
+}

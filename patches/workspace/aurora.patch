diff --git a/tests/touch_visibility_test.cpp b/tests/touch_visibility_test.cpp
new file mode 100644
index 0000000..1ec8afa
--- /dev/null
+++ b/tests/touch_visibility_test.cpp
@@ -0,0 +1,81 @@
+#include "../lib/controller_slots.hpp"
+#include "../lib/touch_visibility.hpp"
+
+#include <gtest/gtest.h>
+
+#include <algorithm>
+
+namespace aurora::touch {
+namespace {
+
+using input::ControllerSlotSnapshot;
+using input::plan_controller_slots;
+
+constexpr TouchPortController kGamepad{.assigned = true, .isVirtual = false, .hasStick = true, .hasFaceButtons = true};
+constexpr bool kAutoHideDefault = true; // no saved preference
+
+// Player 1 (port 0) has a usable controller after Aurora plans the slots.
+bool player_one_has_controller(const std::vector<ControllerSlotSnapshot>& snapshots, const TouchPortController profile) {
+  const auto decisions = plan_controller_slots(snapshots, 4);
+  const bool onPortZero = std::ranges::any_of(
+      decisions, [](const auto& decision) { return !decision.remove && decision.playerSlot == 0; });
+  return onPortZero && usable_touch_port_controller(profile);
+}
+
+TEST(TouchVisibility, ControllerPresentBeforeLaunchHidesTouchByDefault) {
+  const bool controller = player_one_has_controller(
+      {{.instance = 7, .playerSlot = -1, .connected = true, .enumerated = true, .preserveSlot = false}}, kGamepad);
+  EXPECT_TRUE(touch_controls_hidden(controller, kAutoHideDefault, false));
+}
+
+TEST(TouchVisibility, DisconnectingTheOnlyControllerShowsTouch) {
+  const bool controller = player_one_has_controller(
+      {{.instance = 7, .playerSlot = 0, .connected = false, .enumerated = false, .preserveSlot = true}}, kGamepad);
+  EXPECT_FALSE(touch_controls_hidden(controller, kAutoHideDefault, false));
+}
+
+TEST(TouchVisibility, RemovingPlayerTwoKeepsPlayerOnesControllerHidingTouch) {
+  const bool controller = player_one_has_controller(
+      {
+          {.instance = 7, .playerSlot = 0, .connected = true, .enumerated = true, .preserveSlot = true},
+          {.instance = 9, .playerSlot = 1, .connected = false, .enumerated = false, .preserveSlot = true},
+      },
+      kGamepad);
+  EXPECT_TRUE(touch_controls_hidden(controller, kAutoHideDefault, false));
+}
+
+TEST(TouchVisibility, ControllerOwnedByAnotherPlayerDoesNotHideTouch) {
+  // Player 1's controller left; player 2's stays on its own port.
+  const bool controller = player_one_has_controller(
+      {
+          {.instance = 7, .playerSlot = 0, .connected = false, .enumerated = false, .preserveSlot = true},
+          {.instance = 9, .playerSlot = 1, .connected = true, .enumerated = true, .preserveSlot = true},
+      },
+      kGamepad);
+  EXPECT_FALSE(touch_controls_hidden(controller, kAutoHideDefault, false));
+}
+
+TEST(TouchVisibility, VirtualOrIncompleteControllersNeverHideTouch) {
+  const std::vector<ControllerSlotSnapshot> onPortZero{
+      {.instance = 7, .playerSlot = 0, .connected = true, .enumerated = true, .preserveSlot = true}};
+  auto virtualPad = kGamepad;
+  virtualPad.isVirtual = true;
+  auto menuOnly = kGamepad;
+  menuOnly.hasStick = false;
+  EXPECT_FALSE(touch_controls_hidden(player_one_has_controller(onPortZero, virtualPad), kAutoHideDefault, false));
+  EXPECT_FALSE(touch_controls_hidden(player_one_has_controller(onPortZero, menuOnly), kAutoHideDefault, false));
+}
+
+TEST(TouchVisibility, PreferenceAndShowApplyWithTheControllerStillConnected) {
+  const bool controller = player_one_has_controller(
+      {{.instance = 7, .playerSlot = 0, .connected = true, .enumerated = true, .preserveSlot = true}}, kGamepad);
+  // Show Touch Controls (or the switch turned off) sets auto-hide off: visible at once.
+  EXPECT_FALSE(touch_controls_hidden(controller, false, false));
+  // Turning auto-hide back on applies to the connected controller at once.
+  EXPECT_TRUE(touch_controls_hidden(controller, true, false));
+  // Editing the layout always shows the controls.
+  EXPECT_FALSE(touch_controls_hidden(controller, true, true));
+}
+
+} // namespace
+} // namespace aurora::touch

+- (void)stickChanged:(SunPadStickView *)stick x:(float)x y:(float)y {
+    if (_editingLayout)
+        return;
+    int8_t xi = (int8_t)std::lround(x * 127.0f);
+    int8_t yi = (int8_t)std::lround(y * 127.0f);
+    if (stick == _moveStick) {
+        _touchState.stickX = xi;
+        _touchState.stickY = yi;
+    } else {
+        _touchState.cStickX = xi;
+        _touchState.cStickY = yi;
+    }
+    _touchState.connected = 1;
+    [[SunPadInputMixer sharedMixer] setInputState:_touchState fromTouch:YES];
+}
+
+- (void)buttonDown:(SunPadGameButton *)button {
+    if (_editingLayout)
+        return;
+    BOOL shoulder = button.inputMask == SunPadButtonL ||
+                    button.inputMask == SunPadButtonR;
+    if (shoulder && button.latched) {
+        button.latched = NO;
+        button.physicallyPressed = NO;
+        ++button.holdSequence;
+        _touchState.buttons &= ~button.inputMask;
+        if (button.inputMask == SunPadButtonL)
+            _touchState.triggerL = 0;
+        else
+            _touchState.triggerR = 0;
+        button.transform = CGAffineTransformIdentity;
+        [self updateShoulderLatchAppearance:button];
+        _touchState.connected = 1;
+        [[SunPadInputMixer sharedMixer] setInputState:_touchState fromTouch:YES];
+        SunPadLog(@"touch shoulder %@ unlatched", button.currentTitle);
+        return;
+    }
+
+    button.physicallyPressed = shoulder;
+    _touchState.buttons |= button.inputMask;
+    if (button.inputMask == SunPadButtonL)
+        _touchState.triggerL = 255;
+    if (button.inputMask == SunPadButtonR)
+        _touchState.triggerR = 255;
+    button.transform = CGAffineTransformMakeScale(0.92, 0.92);
+    _touchState.connected = 1;
+    [[SunPadInputMixer sharedMixer] setInputState:_touchState fromTouch:YES];
+
+    if (shoulder) {
+        NSUInteger sequence = ++button.holdSequence;
+        __weak SunPadGameOverlay *weakSelf = self;
+        __weak SunPadGameButton *weakButton = button;
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.5 * NSEC_PER_SEC)),
+                       dispatch_get_main_queue(), ^{
+            SunPadGameOverlay *strongSelf = weakSelf;
+            SunPadGameButton *strongButton = weakButton;
+            if (strongSelf == nil || strongButton == nil || strongSelf->_editingLayout ||
+                !strongButton.physicallyPressed || strongButton.latched ||
+                strongButton.holdSequence != sequence)
+                return;
+            strongButton.latched = YES;
+            strongButton.transform = CGAffineTransformIdentity;
+            [strongSelf updateShoulderLatchAppearance:strongButton];
+            [[[UIImpactFeedbackGenerator alloc]
+                initWithStyle:UIImpactFeedbackStyleMedium] impactOccurred];
+            SunPadLog(@"touch shoulder %@ latched after hold", strongButton.currentTitle);
+        });
+    }
+}
+
+- (void)buttonUp:(SunPadGameButton *)button {
+    if (_editingLayout)
+        return;
+    BOOL shoulder = button.inputMask == SunPadButtonL ||
+                    button.inputMask == SunPadButtonR;
+    if (shoulder) {
+        button.physicallyPressed = NO;
+        ++button.holdSequence;
+        button.transform = CGAffineTransformIdentity;
+        if (button.latched) {
+            [self updateShoulderLatchAppearance:button];
+            _touchState.connected = 1;
+            [[SunPadInputMixer sharedMixer] setInputState:_touchState fromTouch:YES];
+            return;
+        }
+    }
+    _touchState.buttons &= ~button.inputMask;
+    if (button.inputMask == SunPadButtonL)
+        _touchState.triggerL = 0;
+    if (button.inputMask == SunPadButtonR)
+        _touchState.triggerR = 0;
+    button.transform = CGAffineTransformIdentity;
+    _touchState.connected = 1;
+    [[SunPadInputMixer sharedMixer] setInputState:_touchState fromTouch:YES];
+}
+
+- (void)updateShoulderLatchAppearance:(SunPadGameButton *)button {
+    if (button.inputMask != SunPadButtonL && button.inputMask != SunPadButtonR)
+        return;
+    button.backgroundColor = button.latched
+        ? [UIColor colorWithRed:0.05 green:0.55 blue:0.78 alpha:0.96]
+        : button.normalFillColor;
+    button.layer.borderColor = (button.latched
+        ? [UIColor colorWithRed:0.42 green:0.90 blue:1.0 alpha:1.0]
+        : [UIColor colorWithWhite:1.0 alpha:0.68]).CGColor;
+    button.layer.borderWidth = button.latched ? 4.0 : 2.0;
+    button.accessibilityValue = button.latched ? @"Locked" : @"Unlocked";
+}
+
+- (void)clearTouchInput {
+    for (SunPadGameButton *button in _buttons) {
+        button.transform = CGAffineTransformIdentity;
+        button.physicallyPressed = NO;
+        button.latched = NO;
+        ++button.holdSequence;
+        [self updateShoulderLatchAppearance:button];
+    }
+    [_moveStick reset];
+    [_cStick reset];
+    _touchState = {};
+    [[SunPadInputMixer sharedMixer] clearInputFromTouch:YES];
+}

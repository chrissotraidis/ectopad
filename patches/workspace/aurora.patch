--- /dev/null
+++ b/lib/touch_visibility.hpp
@@ -0,0 +1,28 @@
+#pragma once
+
+namespace aurora::touch {
+
+/* The iOS touch controls drive player 1 (PADSetVirtualStatus(0, ...)). Only a
+ * usable physical controller on that port stands in for them: never an SDL
+ * virtual joystick (the app's own test pad), and never a profile without a
+ * movement stick and face buttons. A controller on another port does not count. */
+struct TouchPortController {
+  bool assigned = false;
+  bool isVirtual = false;
+  bool hasStick = false;
+  bool hasFaceButtons = false;
+};
+
+constexpr bool usable_touch_port_controller(const TouchPortController& controller) noexcept {
+  return controller.assigned && !controller.isVirtual && controller.hasStick && controller.hasFaceButtons;
+}
+
+/* "Auto-hide Touch Controls with Controller": hidden while such a controller is
+ * present and auto-hide is on. Show Touch Controls turns auto-hide off. Editing
+ * the layout always shows the controls so it stays possible and escapable. */
+constexpr bool touch_controls_hidden(const bool usableController, const bool autoHide,
+                                     const bool editingLayout) noexcept {
+  return usableController && autoHide && !editingLayout;
+}
+
+} // namespace aurora::touch

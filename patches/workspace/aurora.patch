+BOOL ReadHeaderAndSize(NSString *path, NSError **error) {
+  int fd = open(path.fileSystemRepresentation, O_RDONLY);
+  if (fd < 0) {
+    if (error != nullptr)
+      *error = POSIXError(10, @"The selected file could not be opened");
+    return NO;
+  }
+
+  struct stat info = {};
+  uint8_t header[0x100] = {};
+  ssize_t headerLength = 0;
+  if (fstat(fd, &info) != 0) {
+    const int savedErrno = errno;
+    close(fd);
+    errno = savedErrno;
+    if (error != nullptr)
+      *error = POSIXError(11, @"The selected image size could not be read");
+    return NO;
+  }
+  do {
+    headerLength = pread(fd, header, sizeof(header), 0);
+  } while (headerLength < 0 && errno == EINTR);
+  const int savedErrno = headerLength < 0 ? errno : 0;
+  close(fd);
+
+  if (info.st_size != static_cast<off_t>(SupportedImageSize)) {
+    if (error != nullptr) {
+      *error = ErrorWithMessage(11,
+          @"The image size does not match Metroid Prime USA revision 2.");
+    }
+    return NO;
+  }
+  if (headerLength != static_cast<ssize_t>(sizeof(header))) {
+    if (savedErrno != 0) {
+      errno = savedErrno;
+      if (error != nullptr)
+        *error = POSIXError(12, @"The disc header could not be read");
+    } else if (error != nullptr) {
+      *error = ErrorWithMessage(12, @"The disc header is incomplete.");
+    }
+    return NO;
+  }
+
+  uint32_t magic = 0;
+  memcpy(&magic, header + 0x1c, sizeof(magic));
+  magic = CFSwapInt32BigToHost(magic);
+  if (magic != GameCubeMagic) {
+    if (error != nullptr) {
+      *error = ErrorWithMessage(13,
+          @"The selected file is not a GameCube disc image (bad magic).");
+    }
+    return NO;
+  }
+  if (memcmp(header, SupportedGameId, 6) != 0) {
+    char gameId[7] = {};
+    memcpy(gameId, header, 6);
+    NSString *actual = [[NSString alloc] initWithBytes:gameId
+                                                length:6
+                                              encoding:NSASCIIStringEncoding] ?: @"unknown";
+    if (error != nullptr) {
+      *error = ErrorWithMessage(14, [NSString stringWithFormat:
+          @"Unsupported game ID '%@'; this build requires GM8E01.", actual]);
+    }
+    return NO;
+  }
+  if (header[6] != SupportedDiscNumber || header[7] != SupportedRevision) {
+    if (error != nullptr) {
+      *error = ErrorWithMessage(15,
+          @"This build requires Metroid Prime USA disc 0, revision 2.");
+    }
+    return NO;
+  }
+  return YES;
+}
+
+NSString *SHA1ForFile(NSString *path, NSError **error) {
+  int fd = open(path.fileSystemRepresentation, O_RDONLY);
+  if (fd < 0) {
+    if (error != nullptr)
+      *error = POSIXError(20, @"The staged image could not be opened");
+    return nil;
+  }
+
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+  CC_SHA1_CTX context;
+  CC_SHA1_Init(&context);
+  std::vector<uint8_t> buffer(1024 * 1024);
+  while (true) {
+    const ssize_t amount = read(fd, buffer.data(), buffer.size());
+    if (amount == 0)
+      break;
+    if (amount < 0) {
+      if (errno == EINTR)
+        continue;
+      if (error != nullptr)
+        *error = POSIXError(21, @"The staged image could not be verified");
+      close(fd);
+      return nil;
+    }
+    CC_SHA1_Update(&context, buffer.data(), static_cast<CC_LONG>(amount));
+  }
+  unsigned char digest[CC_SHA1_DIGEST_LENGTH];
+  CC_SHA1_Final(digest, &context);
+#pragma clang diagnostic pop
+  close(fd);
+
+  NSMutableString *hex = [NSMutableString stringWithCapacity:CC_SHA1_DIGEST_LENGTH * 2];
+  for (unsigned char byte : digest)
+    [hex appendFormat:@"%02x", byte];
+  return hex;
+}
+
+BOOL CopyToStaging(NSString *source, NSString *staging,
+                   MetaforceGameDataImportProgress progress, NSError **error) {
+  int sourceFd = open(source.fileSystemRepresentation, O_RDONLY);
+  if (sourceFd < 0) {
+    if (error != nullptr)
+      *error = POSIXError(30, @"The selected image could not be opened for copying");
+    return NO;
+  }
+  int stagingFd = open(staging.fileSystemRepresentation,
+                       O_WRONLY | O_CREAT | O_EXCL, S_IRUSR | S_IWUSR);
+  if (stagingFd < 0) {
+    if (error != nullptr)
+      *error = POSIXError(31, @"Private staging could not be created");
+    close(sourceFd);
+    return NO;
+  }
+
+  BOOL ok = YES;
+  uint64_t copied = 0;
+  uint64_t nextProgress = 64ULL * 1024 * 1024;
+  std::vector<uint8_t> buffer(1024 * 1024);
+  while (ok) {
+    ssize_t amount = read(sourceFd, buffer.data(), buffer.size());
+    if (amount == 0)
+      break;
+    if (amount < 0) {
+      if (errno == EINTR)
+        continue;
+      if (error != nullptr)
+        *error = POSIXError(32, @"The selected image could not be read");
+      ok = NO;
+      break;
+    }
+
+    ssize_t written = 0;
+    while (written < amount) {
+      const ssize_t result = write(stagingFd,
+                                   buffer.data() + static_cast<size_t>(written),
+                                   static_cast<size_t>(amount - written));
+      if (result < 0 && errno == EINTR)
+        continue;
+      if (result <= 0) {
+        if (error != nullptr)
+          *error = POSIXError(33, @"The private image copy could not be written");
+        ok = NO;
+        break;
+      }
+      written += result;
+    }
+    copied += static_cast<uint64_t>(amount);
+    if (copied >= nextProgress) {
+      ReportProgress(progress, @"Copying the disc…",
+                     MIN(0.85, 0.05 + 0.8 * static_cast<double>(copied) /
+                                      static_cast<double>(SupportedImageSize)));
+      nextProgress += 64ULL * 1024 * 1024;
+    }
+  }
+  if (ok && copied != SupportedImageSize) {
+    if (error != nullptr)
+      *error = ErrorWithMessage(34, @"The copied image size changed during import.");
+    ok = NO;
+  }
+  if (ok && fsync(stagingFd) != 0) {
+    if (error != nullptr)
+      *error = POSIXError(35, @"The private image copy could not be synchronized");
+    ok = NO;
+  }
+  close(stagingFd);
+  close(sourceFd);
+  return ok;
+}
+
+void RemoveStaleImports(NSString *root, NSString *exceptPath) {
+  NSArray<NSString *> *entries = [[NSFileManager defaultManager]
+      contentsOfDirectoryAtPath:root error:nil];
+  for (NSString *entry in entries) {
+    if (![entry hasPrefix:StagingPrefix])
+      continue;
+    NSString *path = [root stringByAppendingPathComponent:entry];
+    if (![path isEqualToString:exceptPath])
+      [[NSFileManager defaultManager] removeItemAtPath:path error:nil];
+  }
+}
+
+void SyncDirectory(NSString *root) {
+  int fd = open(root.fileSystemRepresentation, O_RDONLY);
+  if (fd >= 0) {
+    if (fsync(fd) != 0)
+      SunPadLog(@"game data directory sync warning errno=%d", errno);
+    close(fd);
+  }
+}
+
+} // namespace
+
+NSString *MetaforceGameDataDestinationPath(void) {
+  NSString *root = StoreRoot();
+  return root.length == 0 ? @"" : [root stringByAppendingPathComponent:@"game.iso"];
+}
+
+NSString *MetaforceResolveImportTestPath(NSString *requestedPath) {
+  if ([[NSFileManager defaultManager] fileExistsAtPath:requestedPath])
+    return requestedPath;
+  NSString *prefix = @"/tmp/";
+  if ([requestedPath hasPrefix:prefix]) {
+    NSString *relative = [requestedPath substringFromIndex:prefix.length];
+    NSString *sandboxPath = [NSTemporaryDirectory() stringByAppendingPathComponent:relative];
+    if ([[NSFileManager defaultManager] fileExistsAtPath:sandboxPath])
+      return sandboxPath;
+  }
+  return requestedPath;
+}
+
+extern "C" int MetaforceRunGameDataImportTest(const char *requestedPath) {
+  NSString *requested = requestedPath == nullptr
+      ? @"" : [NSString stringWithUTF8String:requestedPath];
+  NSString *resolved = MetaforceResolveImportTestPath(requested ?: @"");
+  dispatch_semaphore_t done = dispatch_semaphore_create(0);
+  __block BOOL succeeded = NO;
+  SunPadDiagnosticsStart();
+  SunPadLog(@"game data import test requested filename=%@", resolved.lastPathComponent);
+  MetaforceImportGameDataFromURL([NSURL fileURLWithPath:resolved], nil,
+      ^(BOOL success, NSString *) {
+        succeeded = success;
+        dispatch_semaphore_signal(done);
+      });
+  while (dispatch_semaphore_wait(
+      done, dispatch_time(DISPATCH_TIME_NOW, 100 * NSEC_PER_MSEC)) != 0) {
+    [[NSRunLoop mainRunLoop]
+        runUntilDate:[NSDate dateWithTimeIntervalSinceNow:0.01]];
+  }
+  return succeeded ? 0 : 2;
+}
+
+extern "C" int MetaforceRunGameDataRemovalTest(void) {
+  SunPadDiagnosticsStart();
+  NSError *error = nil;
+  if (MetaforceRemoveStoredGameData(&error))
+    return 0;
+  SunPadLog(@"stored game data removal failed reason=%@",
+            error.localizedDescription ?: @"unknown");
+  return 3;
+}
+
+NSArray<NSURL *> *MetaforceGameDataImagesInDocumentsDirectory(void) {
+  NSURL *documents = [[[NSFileManager defaultManager]
+      URLsForDirectory:NSDocumentDirectory inDomains:NSUserDomainMask] firstObject];
+  if (documents == nil)
+    return @[];
+  NSArray<NSURL *> *entries = [[NSFileManager defaultManager]
+      contentsOfDirectoryAtURL:documents
+    includingPropertiesForKeys:@[NSURLIsRegularFileKey]
+                       options:NSDirectoryEnumerationSkipsHiddenFiles
+                         error:nil];
+  NSMutableArray<NSURL *> *images = [NSMutableArray array];
+  NSSet<NSString *> *extensions = [NSSet setWithArray:@[@"iso", @"gcm"]];
+  for (NSURL *entry in entries) {
+    NSNumber *regular = nil;
+    [entry getResourceValue:&regular forKey:NSURLIsRegularFileKey error:nil];
+    if (regular.boolValue &&
+        [extensions containsObject:entry.pathExtension.lowercaseString]) {
+      [images addObject:entry];
+    }
+  }
+  [images sortUsingComparator:^NSComparisonResult(NSURL *left, NSURL *right) {
+    return [left.lastPathComponent localizedStandardCompare:right.lastPathComponent];
+  }];
+  return images;
+}
+
+void MetaforceImportGameDataFromURL(
+    NSURL *url, MetaforceGameDataImportProgress progress,
+    MetaforceGameDataImportCompletion completion) {
+  dispatch_async(ImportQueue(), ^{
+    NSString *root = StoreRoot();
+    NSString *destination = MetaforceGameDataDestinationPath();
+    NSString *staging = root.length == 0 ? @"" : [root stringByAppendingPathComponent:
+        [StagingPrefix stringByAppendingString:NSUUID.UUID.UUIDString]];
+    __block NSError *operationError = nil;
+    __block BOOL success = NO;
+
+    BOOL securityScoped = [url startAccessingSecurityScopedResource];
+    SunPadLog(@"game data import begin filename=%@", url.lastPathComponent ?: @"unknown");
+    ReportProgress(progress, @"Validating the selected disc…", 0.02);
+
+    if (root.length == 0 || destination.length == 0) {
+      operationError = ErrorWithMessage(40, @"Metaforce private storage is unavailable.");
+    } else if (![[NSFileManager defaultManager]
+                   createDirectoryAtPath:root
+             withIntermediateDirectories:YES attributes:nil error:&operationError]) {
+      // createDirectoryAtPath also succeeds when the directory already exists.
+    } else {
+      RemoveStaleImports(root, staging);
+      // UIDocumentPicker is configured with asCopy:YES, so its URL is already a
+      // stable local copy. Match SunPad's import path by opening that URL
+      // directly while security-scoped access is active.
+      if (ReadHeaderAndSize(url.path, &operationError)) {
+        SunPadLog(@"game data source header validated id=GM8E01 revision=2");
+        ReportProgress(progress, @"Copying the disc into private storage…", 0.05);
+        CopyToStaging(url.path, staging, progress, &operationError);
+      }
+    }
+
+    if (securityScoped)
+      [url stopAccessingSecurityScopedResource];
+
+    if (operationError == nil) {
+      ReportProgress(progress, @"Verifying the private copy…", 0.88);
+      if (ReadHeaderAndSize(staging, &operationError)) {
+        NSString *sha1 = SHA1ForFile(staging, &operationError);
+        if (operationError == nil && ![sha1 isEqualToString:SupportedSHA1]) {
+          operationError = ErrorWithMessage(41,
+              @"The image SHA-1 does not match Metroid Prime USA revision 2.");
+        }
+        if (operationError == nil) {
+          SunPadLog(@"game data staged image validated sha1=%@", sha1);
+          ReportProgress(progress, @"Activating the verified disc…", 0.98);
+          if (rename(staging.fileSystemRepresentation,
+                     destination.fileSystemRepresentation) != 0) {
+            operationError = POSIXError(42, @"The verified image could not be activated");
+          } else {
+            SyncDirectory(root);
+            NSURL *destinationURL = [NSURL fileURLWithPath:destination];
+            NSError *metadataError = nil;
+            if (![destinationURL setResourceValue:@YES
+                                           forKey:NSURLIsExcludedFromBackupKey
+                                             error:&metadataError]) {
+              SunPadLog(@"game data backup-exclusion warning=%@",
+                        metadataError.localizedDescription);
+            }
+            metadataError = nil;
+            if (![[NSFileManager defaultManager]
+                setAttributes:@{NSFileProtectionKey:
+                    NSFileProtectionCompleteUntilFirstUserAuthentication}
+                 ofItemAtPath:destination error:&metadataError]) {
+              SunPadLog(@"game data protection warning=%@",
+                        metadataError.localizedDescription);
+            }
+            SunPadSettings *settings = [SunPadSettings sharedSettings];
+            settings.retainedGameDataPath = destination;
+            settings.extractedGameRoot = nil;
+            [settings synchronize];
+            SunPadLog(@"game data import activated filename=game.iso");
+            success = YES;
+          }
+        }
+      }
+    }
+
+    if (!success && staging.length > 0)
+      [[NSFileManager defaultManager] removeItemAtPath:staging error:nil];
+    NSString *message = success
+        ? @"Metroid Prime USA revision 2 was verified and stored privately. Restart EctoPad to use it."
+        : operationError.localizedDescription ?: @"The game-data import failed.";
+    if (!success)
+      SunPadLog(@"game data import rejected reason=%@", message);
+    dispatch_async(dispatch_get_main_queue(), ^{
+      completion(success, message);
+    });
+  });
+}
+
+BOOL MetaforceRemoveStoredGameData(NSError **error) {
+  NSString *root = StoreRoot();
+  NSString *destination = MetaforceGameDataDestinationPath();
+  if (root.length == 0 || destination.length == 0) {
+    if (error != nullptr)
+      *error = ErrorWithMessage(50, @"Metaforce private storage is unavailable.");
+    return NO;
+  }
+
+  RemoveStaleImports(root, @"");
+  if (unlink(destination.fileSystemRepresentation) != 0 && errno != ENOENT) {
+    if (error != nullptr)
+      *error = POSIXError(51, @"Stored game data could not be removed");
+    return NO;
+  }
+  SyncDirectory(root);
+  SunPadSettings *settings = [SunPadSettings sharedSettings];
+  settings.retainedGameDataPath = nil;
+  settings.extractedGameRoot = nil;
+  [settings synchronize];
+  SunPadLog(@"stored game data removed filename=game.iso savesPreserved=yes");
+  return YES;
+}

@@ -21,6 +21,14 @@ static bool has_aurora_cmd(const std::vector<u8>& bytes, u16 cmd) {
   return std::search(bytes.begin(), bytes.end(), pattern.begin(), pattern.end()) != bytes.end();
 }
 
+static u32 single_xf_payload(const std::vector<u8>& bytes) {
+  if (bytes.size() != 9 || bytes[0] != GX_LOAD_XF_REG) {
+    return UINT32_MAX;
+  }
+  return static_cast<u32>(bytes[5]) << 24 | static_cast<u32>(bytes[6]) << 16 |
+         static_cast<u32>(bytes[7]) << 8 | static_cast<u32>(bytes[8]);
+}
+
 // ============================================================================
 // BP registers (direct FIFO writes, no dirty state flush needed)
 // ============================================================================
@@ -1249,6 +1257,35 @@ TEST_F(GXFifoTest, SetArray_LittleEndianFlag_UpdatesStateAndClearsCachedRange) {
   EXPECT_TRUE(gxState().stateDirty);
 }
 
+TEST_F(GXFifoTest, SetArray_ClearThenRebindSamePointerInvalidatesCachedRange) {
+  u8 reusedStorage[32]{};
+
+  // Simulate an area being removed and a later area's array receiving the exact same allocator address.
+  GXSetArray(GX_VA_POS, nullptr, 0, 0, true);
+  GXSetArray(GX_VA_POS, reusedStorage, sizeof(reusedStorage), 12, true);
+  auto bytes = capture_fifo();
+
+  reset_gx_state();
+  auto& array = gxState().arrays[GX_VA_POS];
+  array.data = reusedStorage;
+  array.size = sizeof(reusedStorage);
+  array.stride = 12;
+  array.le = true;
+  array.cachedRange.offset = 64;
+  array.cachedRange.size = sizeof(reusedStorage);
+  gxState().stateDirty = false;
+
+  decode_fifo(bytes);
+
+  EXPECT_EQ(array.data, reusedStorage);
+  EXPECT_EQ(array.size, sizeof(reusedStorage));
+  EXPECT_EQ(array.stride, 12);
+  EXPECT_TRUE(array.le);
+  EXPECT_EQ(array.cachedRange.offset, 0u);
+  EXPECT_EQ(array.cachedRange.size, 0u);
+  EXPECT_TRUE(gxState().stateDirty);

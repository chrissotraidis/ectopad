diff --git a/include/aurora/audio.h b/include/aurora/audio.h
new file mode 100644
index 0000000..7e7d0e6
--- /dev/null
+++ b/include/aurora/audio.h
@@ -0,0 +1,42 @@
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * Minimal SDL3-backed audio output device for Metaforce.
+ *
+ * The host supplies interleaved stereo float samples (sample rate set at open
+ * time, default 32000 Hz) via the supply callback. The callback is invoked
+ * from the main thread inside aurora_audio_pump(), which maintains a bounded
+ * wall-clock reserve independently of the current render frame rate.
+ */
+typedef void (*AuroraAudioSupplyCallback)(float* data, int frames);
+
+/** Opens the default audio device. Returns false on failure. */
+bool aurora_audio_open(int sampleRate, AuroraAudioSupplyCallback cb);
+
+/** Tops up the device's bounded reserve; call once per frame from the main thread. */
+void aurora_audio_pump(void);
+
+/** Closes the audio device (idempotent). */
+void aurora_audio_close(void);
+
+/** True if the device is currently open. */
+bool aurora_audio_is_open(void);
+
+/** Convenience: silence a buffer (used by hosts that have nothing to play). */
+void aurora_audio_fill_silence(float* data, int frames);
+
+/** Writes source-level mixer diagnostics to the platform log when supported. */
+void aurora_audio_log_mix_sources(float frontendPeak, float amusePeak, float streamPeak,
+                                  float outputPeak, unsigned long long frontendJumps,
+                                  unsigned long long amuseJumps, unsigned long long streamJumps,
+                                  unsigned long long totalVoices,
+                                  unsigned long long runningVoices,
+                                  unsigned long long activeStreams);
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/include/aurora/touch.hpp b/include/aurora/touch.hpp
new file mode 100644
index 0000000..72c1a24
--- /dev/null
+++ b/include/aurora/touch.hpp
@@ -0,0 +1,54 @@
+#pragma once
+
+#include <cstdint>
+#include <string_view>
+
+struct SDL_Window;
+
+namespace aurora::touch {
+
+/* Normalized GameCube touch state published by the iOS UIKit overlay (the
+ * SunPad port). */
+struct IosTouchState {
+  int8_t stickX = 0, stickY = 0;
+  int8_t cStickX = 0, cStickY = 0;
+  uint8_t triggerL = 0, triggerR = 0;
+  uint16_t buttons = 0;
+  bool connected = false;
+};
+
+/* iOS: attach the SunPad-style UIKit touch overlay to the SDL window (no-op
+ * elsewhere). The overlay owns touch input on iOS. */
+bool attach_ios_overlay(SDL_Window* sdlWindow) noexcept;
+
+/* iOS: consume the overlay's merged touch state (called from the pad layer
+ * once per read). Returns false when idle or when the overlay is not
+ * attached. */
+bool consume_ios_touch_state(IosTouchState& out) noexcept;
+
+/* Called after a frame reaches the operating-system surface. The iOS bridge
+ * uses this to feed SunPad's FPS presentation; the non-iOS implementation is
+ * a no-op. */
+void ios_overlay_frame_presented() noexcept;
+
+/* Reattach the UIKit overlay to SDL's current root controller after an iOS
+ * lifecycle transition. Non-iOS builds are no-ops. */
+void recover_ios_overlay(std::string_view reason) noexcept;
+
+/* Low-frequency persistent runtime breadcrumb used by native game systems. */
+void log_ios_runtime_event(std::string_view event) noexcept;
+
+/* iOS: the controller set or player assignment changed; the overlay re-checks
+ * whether player 1 has a usable physical controller. No-op elsewhere. */
+void ios_controllers_changed() noexcept;
+
+/* Player 1, which the touch controls drive, has a usable physical controller
+ * (Aurora's controller slots; never a virtual or stick-less device). */
+bool touch_player_has_usable_controller() noexcept;
+
+/* iOS applies SunPad's persisted, deliberately narrow physical
+ * A/B/X/Y/right-shoulder -> GameCube A/B/X/Y/Z permutation. Other platforms
+ * return the input unchanged. */
+uint16_t map_ios_controller_face_buttons(uint16_t buttons, uint16_t physicalButtons) noexcept;
+
+} // namespace aurora::touch
diff --git a/lib/audio.cpp b/lib/audio.cpp
new file mode 100644
index 0000000..32c93ea
--- /dev/null
+++ b/lib/audio.cpp
@@ -0,0 +1,221 @@
+#include <aurora/audio.h>
+
+#include <SDL3/SDL.h>
+#include <SDL3/SDL_audio.h>
+
+#include "logging.hpp"
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstring>
+#include <vector>
+
+namespace {
+aurora::Module Log("aurora::audio");
+
+SDL_AudioDeviceID g_device = 0;
+SDL_AudioStream* g_stream = nullptr;
+AuroraAudioSupplyCallback g_cb = nullptr;
+std::atomic<bool> g_running{false};
+int g_sampleRate = 32000;
+int g_outputSampleRate = 32000;
+int g_outputBytesPerFrame = 2 * sizeof(float);
+uint64_t g_pumpCount = 0;
+uint64_t g_underrunCount = 0;
+uint64_t g_clippedSampleCount = 0;
+float g_peakSinceLog = 0.f;
+
+#if TARGET_OS_IOS
+extern "C" bool EctoPadActivateAudioSession(void);
+extern "C" void EctoPadLogAudioPump(int suppliedFrames, int availableFrames,
+                                      int targetFrames, unsigned long long underruns,
+                                      float peak, unsigned long long clippedSamples);
+extern "C" void EctoPadLogAudioSources(float frontendPeak, float amusePeak, float streamPeak,
+                                         float outputPeak, unsigned long long frontendJumps,
+                                         unsigned long long amuseJumps, unsigned long long streamJumps,
+                                         unsigned long long totalVoices,
+                                         unsigned long long runningVoices,
+                                         unsigned long long activeStreams);
+#endif
+
+constexpr int kTargetBufferMilliseconds = 120;
+} // namespace
+
+bool aurora_audio_open(int sampleRate, AuroraAudioSupplyCallback cb) {
+  if (g_running.exchange(true, std::memory_order_acq_rel)) {
+    // Already open: allow the host to re-register the supply callback.
+    g_cb = cb;
+    return true;
+  }
+  if (!SDL_InitSubSystem(SDL_INIT_AUDIO)) {
+    Log.error("SDL_InitSubSystem(SDL_INIT_AUDIO) failed: {}", SDL_GetError());
+    g_running.store(false, std::memory_order_release);
+    return false;
+  }
+#if TARGET_OS_IOS
+  EctoPadActivateAudioSession();
+#endif
+  g_sampleRate = sampleRate > 0 ? sampleRate : 32000;
+  const SDL_AudioSpec spec{
+      .format = SDL_AUDIO_F32,
+      .channels = 2,
+      .freq = g_sampleRate,
+  };
+  g_device = SDL_OpenAudioDevice(SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec);
+  if (g_device == 0) {
+    Log.error("SDL_OpenAudioDevice failed: {}", SDL_GetError());
+    SDL_QuitSubSystem(SDL_INIT_AUDIO);
+    g_running.store(false, std::memory_order_release);
+    return false;
+  }
+  SDL_AudioSpec actual{};
+  int sampleFrames = 0;
+  if (SDL_GetAudioDeviceFormat(g_device, &actual, &sampleFrames)) {
+    g_outputSampleRate = actual.freq > 0 ? actual.freq : g_sampleRate;
+    g_outputBytesPerFrame = std::max(1, static_cast<int>(SDL_AUDIO_FRAMESIZE(actual)));
+    Log.info("Audio device opened: format={} channels={} freq={} sampleFrames={}",
+             static_cast<int>(actual.format), actual.channels, actual.freq, sampleFrames);
+  } else {
+    g_outputSampleRate = g_sampleRate;
+    g_outputBytesPerFrame = 2 * sizeof(float);
+    Log.warn("Audio device opened but SDL_GetAudioDeviceFormat failed: {}", SDL_GetError());
+  }
+  // src = the format we push via SDL_PutAudioStreamData (F32 stereo).
+  // dst = nullptr; binding to the device sets the output format, and SDL
+  // converts between the two automatically.
+  g_stream = SDL_CreateAudioStream(&spec, nullptr);
+  if (g_stream == nullptr || !SDL_BindAudioStream(g_device, g_stream)) {
+    Log.error("SDL audio stream create/bind failed: {}", SDL_GetError());
+    if (g_stream != nullptr) {
+      SDL_DestroyAudioStream(g_stream);
+    }
+    SDL_CloseAudioDevice(g_device);
+    g_device = 0;
+    SDL_QuitSubSystem(SDL_INIT_AUDIO);
+    g_running.store(false, std::memory_order_release);
+    return false;
+  }
+  g_cb = cb;
+  g_pumpCount = 0;
+  g_underrunCount = 0;
+  g_clippedSampleCount = 0;
+  g_peakSinceLog = 0.f;
+  Log.info("aurora_audio_open: sampleRate={} targetBufferMs={}", g_sampleRate,
+           kTargetBufferMilliseconds);
+  return true;
+}
+
+void aurora_audio_pump(void) {
+  if (!g_running.load(std::memory_order_acquire) || g_cb == nullptr || g_stream == nullptr) {
+    return;
+  }
+  // Keep a bounded wall-clock reserve instead of assuming this function runs
+  // at 60 FPS. Rendering can temporarily fall below 60 FPS while pipelines
+  // compile or the host is busy; supplying exactly one video frame of audio
+  // per call made the device drain faster than Metaforce could refill it.
+  // SunPad settled on the same 120 ms reserve after its iOS audio work. Unlike
+  // its Dolphin mixer, this SDL stream already preserves its true queue
+  // position, so recovery only needs fresh samples -- never replayed data.
+  // Measure output-ready duration after SDL's format/rate conversion. Raw
+  // input bytes can be consumed into the converter before the device plays
+  // them and would therefore make the producer overfill the stream.
+  const int availableBytes = SDL_GetAudioStreamAvailable(g_stream);
+  if (availableBytes < 0) {
+    Log.warn("SDL_GetAudioStreamAvailable failed: {}", SDL_GetError());
+    return;
+  }
+
+  const int targetOutputFrames = g_outputSampleRate * kTargetBufferMilliseconds / 1000;
+  const int availableOutputFrames = availableBytes / g_outputBytesPerFrame;
+  const int missingOutputFrames = std::max(0, targetOutputFrames - availableOutputFrames);
+  const int frames = static_cast<int>(std::ceil(
+      static_cast<double>(missingOutputFrames) * g_sampleRate / g_outputSampleRate));
+  if (g_pumpCount > 0 && availableOutputFrames == 0) {
+    ++g_underrunCount;
+    Log.warn("Audio queue underrun detected; recovering with fresh samples (count={})",
+             g_underrunCount);
+  }
+  if (frames == 0) {
+    ++g_pumpCount;
+    return;
+  }
+  static std::vector<float> buf;
+  buf.resize(static_cast<size_t>(frames) * 2);
+  g_cb(buf.data(), frames);
+  for (float& sample : buf) {
+    const float magnitude = std::abs(sample);
+    g_peakSinceLog = std::max(g_peakSinceLog, magnitude);
+    if (magnitude > 1.f) {
+      ++g_clippedSampleCount;
+      sample = std::clamp(sample, -1.f, 1.f);
+    }
+  }
+  if (!SDL_PutAudioStreamData(g_stream, buf.data(), static_cast<int>(buf.size() * sizeof(float)))) {
+    Log.warn("SDL_PutAudioStreamData failed: {}", SDL_GetError());
+  }
+  if (++g_pumpCount % 300 == 0) {
+    Log.info("Audio pump: {} input frames supplied, availableOutputFrames={} targetOutputFrames={} underruns={} peak={} clipped={}",
+             frames, SDL_GetAudioStreamAvailable(g_stream) / g_outputBytesPerFrame,
+             targetOutputFrames, g_underrunCount, g_peakSinceLog, g_clippedSampleCount);
+#if TARGET_OS_IOS
+    EctoPadLogAudioPump(frames, SDL_GetAudioStreamAvailable(g_stream) / g_outputBytesPerFrame,
+                        targetOutputFrames, g_underrunCount, g_peakSinceLog,
+                        g_clippedSampleCount);
+#endif
+    g_peakSinceLog = 0.f;
+    g_clippedSampleCount = 0;
+  }
+}
+
+void aurora_audio_close(void) {
+  if (!g_running.exchange(false, std::memory_order_acq_rel)) {
+    return;
+  }
+  if (g_stream != nullptr) {
+    SDL_UnbindAudioStream(g_stream);
+  }
+  if (g_device != 0) {
+    // Close the device before destroying the stream: the SDL audio thread is
+    // still draining from the stream while the device closes, so destroying
+    // the stream first can stall the device close (observed hang on iOS).
+    SDL_CloseAudioDevice(g_device);
+    g_device = 0;
+  }
+  if (g_stream != nullptr) {
+    SDL_DestroyAudioStream(g_stream);
+    g_stream = nullptr;
+  }
+  g_cb = nullptr;
+  SDL_QuitSubSystem(SDL_INIT_AUDIO);
+}
+
+bool aurora_audio_is_open(void) { return g_running.load(std::memory_order_acquire) && g_device != 0; }
+
+void aurora_audio_fill_silence(float* data, int frames) {
+  std::memset(data, 0, static_cast<size_t>(frames) * 2 * sizeof(float));
+}
+
+void aurora_audio_log_mix_sources(float frontendPeak, float amusePeak, float streamPeak,
+                                  float outputPeak, unsigned long long frontendJumps,
+                                  unsigned long long amuseJumps, unsigned long long streamJumps,
+                                  unsigned long long totalVoices,
+                                  unsigned long long runningVoices,
+                                  unsigned long long activeStreams) {
+#if TARGET_OS_IOS
+  EctoPadLogAudioSources(frontendPeak, amusePeak, streamPeak, outputPeak,
+                         frontendJumps, amuseJumps, streamJumps, totalVoices,
+                         runningVoices, activeStreams);
+#else
+  (void)frontendPeak;
+  (void)amusePeak;
+  (void)streamPeak;
+  (void)outputPeak;
+  (void)frontendJumps;
+  (void)amuseJumps;
+  (void)streamJumps;
+  (void)totalVoices;
+  (void)runningVoices;
+  (void)activeStreams;
+#endif
+}

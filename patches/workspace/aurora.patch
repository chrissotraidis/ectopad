diff --git a/lib/controller_slots.hpp b/lib/controller_slots.hpp
new file mode 100644
index 0000000..5b7ef84
--- /dev/null
+++ b/lib/controller_slots.hpp
@@ -0,0 +1,88 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace aurora::input {
+
+struct ControllerSlotSnapshot {
+  uint32_t instance = 0;
+  int32_t playerSlot = -1;
+  bool connected = false;
+  bool enumerated = false;
+  bool preserveSlot = false;
+};
+
+struct ControllerSlotDecision {
+  uint32_t instance = 0;
+  int32_t playerSlot = -1;
+  bool remove = false;
+};
+
+inline std::vector<ControllerSlotDecision> plan_controller_slots(const std::vector<ControllerSlotSnapshot>& snapshots,
+                                                                 const size_t slotCount) {
+  std::vector<ControllerSlotDecision> decisions;
+  decisions.reserve(snapshots.size());
+  for (const auto& snapshot : snapshots) {
+    decisions.push_back({
+        .instance = snapshot.instance,
+        .playerSlot = -1,
+        .remove = !snapshot.connected || !snapshot.enumerated,
+    });
+  }
+
+  std::vector<size_t> live;
+  live.reserve(snapshots.size());
+  for (size_t i = 0; i < snapshots.size(); ++i) {
+    if (!decisions[i].remove) {
+      live.push_back(i);
+    }
+  }
+  std::ranges::sort(live, [&snapshots](const size_t lhs, const size_t rhs) {
+    return snapshots[lhs].instance < snapshots[rhs].instance;
+  });
+
+  if (live.size() == 1) {
+    const auto& sole = snapshots[live.front()];
+    const bool canPreserve =
+        sole.preserveSlot && sole.playerSlot >= 0 && static_cast<size_t>(sole.playerSlot) < slotCount;
+    decisions[live.front()].playerSlot = canPreserve ? sole.playerSlot : (slotCount == 0 ? -1 : 0);
+    return decisions;
+  }
+
+  std::vector<bool> used(slotCount, false);
+  const auto retain_slots = [&](const bool preservedOnly) {
+    for (const size_t i : live) {
+      const auto& snapshot = snapshots[i];
+      if (decisions[i].playerSlot >= 0 || snapshot.preserveSlot != preservedOnly || snapshot.playerSlot < 0 ||
+          static_cast<size_t>(snapshot.playerSlot) >= slotCount || used[snapshot.playerSlot]) {
+        continue;
+      }
+      decisions[i].playerSlot = snapshot.playerSlot;
+      used[snapshot.playerSlot] = true;
+    }
+  };
+
+  // A controller that was already valid before reconciliation wins any slot
+  // conflict with a newly opened controller.
+  retain_slots(true);
+  retain_slots(false);
+
+  for (const size_t i : live) {
+    if (decisions[i].playerSlot >= 0) {
+      continue;
+    }
+    const auto freeSlot = std::ranges::find(used, false);
+    if (freeSlot == used.end()) {
+      continue;
+    }
+    decisions[i].playerSlot = static_cast<int32_t>(std::distance(used.begin(), freeSlot));
+    *freeSlot = true;
+  }
+
+  return decisions;
+}
+
+} // namespace aurora::input

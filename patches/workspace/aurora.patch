+                                         unsigned long long amuseJumps, unsigned long long streamJumps,
+                                         unsigned long long totalVoices,
+                                         unsigned long long runningVoices,
+                                         unsigned long long activeStreams) {
+    SunPadLog(@"audio sources frontend=%.3f amuse=%.3f stream=%.3f output=%.3f jumps=%llu/%llu/%llu voices=%llu/%llu streams=%llu",
+              frontendPeak, amusePeak, streamPeak, outputPeak, frontendJumps,
+              amuseJumps, streamJumps, runningVoices, totalVoices, activeStreams);

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 38e03be..0c3c721 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -51,6 +51,36 @@ corrosion_import_crate(
     ${NOD_IMPORT_ARGS}
 )
 
+# Rust's file!() and tracing metadata otherwise retain absolute checkout,
+# build, and Cargo registry paths in release executables.
+if (APPLE)
+    corrosion_add_target_rustflags(nod_ffi
+        "--remap-path-prefix=${CMAKE_SOURCE_DIR}=metaforce"
+        "--remap-path-prefix=${CMAKE_BINARY_DIR}=build")
+    if (DEFINED ENV{CARGO_HOME} AND NOT "$ENV{CARGO_HOME}" STREQUAL "")
+        corrosion_add_target_rustflags(nod_ffi
+            "--remap-path-prefix=$ENV{CARGO_HOME}=cargo")
+    elseif (DEFINED ENV{HOME} AND NOT "$ENV{HOME}" STREQUAL "")
+        corrosion_add_target_rustflags(nod_ffi
+            "--remap-path-prefix=$ENV{HOME}/.cargo=cargo")
+    endif()
+endif()
+
+# Rust puts weak copies of compiler helpers (__udivti3, __powidf2, ...) in
+# every static library, and Apple's system library exports the same helpers.
+# The linker picks one or the other depending on timing, so identical sources
+# could link differently. Removing Rust's copies leaves the system's only.
+if (APPLE)
+    function(nod_drop_rust_compiler_builtins)
+        add_custom_command(TARGET _cargo-build_nod_ffi POST_BUILD
+            COMMAND sh -c "m=$(\"$0\" t \"$2\" | grep '^compiler_builtins-' || true); [ -z \"$m\" ] || \"$0\" d \"$2\" $m; \"$1\" \"$2\""
+                "${CMAKE_AR}" "${CMAKE_RANLIB}" "${CMAKE_CURRENT_BINARY_DIR}/libnod_ffi.a"
+            VERBATIM)
+    endfunction()
+    # Corrosion copies the library at the end of this directory; run after it.
+    cmake_language(DEFER CALL nod_drop_rust_compiler_builtins)
+endif()
+
 if (NOD_COMPRESS_BZIP2)
     nod_require_bzip2(_nod_bzip2_target)
     target_link_libraries(nod_ffi INTERFACE "${_nod_bzip2_target}")
diff --git a/nod/src/disc/wii.rs b/nod/src/disc/wii.rs

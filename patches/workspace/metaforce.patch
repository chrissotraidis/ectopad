diff --git a/extern/CMakeLists.txt b/extern/CMakeLists.txt
index f1872d0c60a378f800e7735e3162eb36aa5f8658..1756d7b690227cb965d4e1058aac5429747080dd 100644
--- a/extern/CMakeLists.txt
+++ b/extern/CMakeLists.txt
@@ -13,6 +13,20 @@ if (NOT TARGET spdlog)
   add_subdirectory(spdlog EXCLUDE_FROM_ALL)
 endif ()
 
+# Restored Metaforce audio stack. These sources are pinned and vendored by the
+# Ectopad build, and must be available before RuntimeCommon is configured.
+add_subdirectory(athena EXCLUDE_FROM_ALL)
+add_subdirectory(logvisor EXCLUDE_FROM_ALL)
+set(AMUSE_BUILD_EDITOR OFF CACHE BOOL "Build Amuse editor tools" FORCE)
+add_subdirectory(amuse EXCLUDE_FROM_ALL)
+set(BUILD_TESTS OFF CACHE BOOL "Build soxr tests" FORCE)
+set(BUILD_EXAMPLES OFF CACHE BOOL "Build soxr examples" FORCE)
+set(BUILD_SHARED_LIBS OFF CACHE BOOL "Build shared libraries" FORCE)
+# soxr declares a pre-3.5 CMake minimum, which CMake 4 rejects without this.
+set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
+add_subdirectory(soxr EXCLUDE_FROM_ALL)
+unset(CMAKE_POLICY_VERSION_MINIMUM)
+
 if (WIN32 AND NOT TARGET nowide)
   include(FetchContent)
   FetchContent_Declare(

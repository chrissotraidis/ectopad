+std::unique_ptr<amuse::IMIDIReader> SDLBackendVoiceAllocator::allocateMIDIReader(amuse::Engine&) {
+  return std::make_unique<NullMIDIReader>();
+}
+
+amuse::AudioChannelSet SDLBackendVoiceAllocator::getAvailableSet() { return amuse::AudioChannelSet::Stereo; }
+
+void SDLBackendVoiceAllocator::setVolume(float vol) { m_totalVol = vol; }
+
+void SDLBackendVoiceAllocator::setCallbackInterface(amuse::Engine* engine) { m_cbInterface = engine; }
+
+void SDLBackendVoiceAllocator::pumpAndMix(size_t frames, float* dataOut) {
+  std::lock_guard<std::recursive_mutex> lock(m_lock);
+  static uint64_t s_pumpCount = 0;
+  if (++s_pumpCount % 300 == 0) {
+    size_t running = 0;
+    for (const SDLBackendVoice* vox : m_voices) {
+      if (vox->m_running) {
+        ++running;
+      }
+    }
+    if (running > 0 || !m_voices.empty()) {
+      spdlog::info("SDLBackend: {} voices ({} running), {} submixes", m_voices.size(), running, m_submixes.size());
+    }
+  }
+  if (dataOut) {
+    std::memset(dataOut, 0, sizeof(float) * frames * kChannelCount);
+  }
+
+  if (m_submixesDirty) {
+    m_linearizedSubmixes.clear();
+    m_mainSubmix->linearizeC3(m_linearizedSubmixes);
+    m_submixesDirty = false;
+  }
+
+  m_mainSubmix->m_redirect = dataOut;
+
+  size_t remFrames = frames;
+  while (remFrames) {
+    const size_t thisFrames = std::min(remFrames, m_5msFrames);
+    const double dt = static_cast<double>(thisFrames) / static_cast<double>(m_5msFrames) * 5.0 / 1000.0;
+    if (m_cbInterface) {
+      m_cbInterface->_on5MsInterval(*this, dt);
+    }
+
+    for (auto it = m_linearizedSubmixes.rbegin(); it != m_linearizedSubmixes.rend(); ++it) {
+      (*it)->zeroFill();
+    }
+
+    // SoundMacro processing may allocate child voices while a voice is being
+    // pumped. Snapshot the registry so those allocations cannot invalidate
+    // this pass; new voices join on the next 5 ms chunk.
+    const std::vector<SDLBackendVoice*> voices = m_voices;
+    for (SDLBackendVoice* vox : voices) {
+      if (vox->m_running) {
+        vox->pumpAndMix(thisFrames);
+      }
+    }
+
+    for (auto it = m_linearizedSubmixes.rbegin(); it != m_linearizedSubmixes.rend(); ++it) {
+      (*it)->pumpAndMix(thisFrames);
+    }
+
+    remFrames -= thisFrames;
+    if (dataOut) {
+      const size_t sampleCount = thisFrames * kChannelCount;
+      for (size_t i = 0; i < sampleCount; ++i) {
+        dataOut[i] *= m_totalVol;
+      }
+      dataOut += sampleCount;
+    }
+  }
+
+  if (m_cbInterface) {
+    m_cbInterface->_onPumpCycleComplete(*this);
+  }
+}
+
+void SDLBackendVoiceAllocator::getVoiceCounts(size_t& total, size_t& running) {
+  std::lock_guard<std::recursive_mutex> lock(m_lock);
+  total = m_voices.size();
+  running = 0;
+  for (const SDLBackendVoice* voice : m_voices) {
+    if (voice->m_running) {
+      ++running;
+    }
+  }
+}
+
+SDLBackendVoice::SDLBackendVoice(SDLBackendVoiceAllocator& root, amuse::Voice& clientVox, double sampleRate,
+                                 bool dynamicPitch)
+: m_root(root), m_clientVox(clientVox), m_dynamicPitch(dynamicPitch), m_sourceRate(sampleRate) {
+  soxr_error_t error = nullptr;
+  const soxr_io_spec_t ioSpec = soxr_io_spec(SOXR_INT16_I, SOXR_FLOAT32_I);
+  const soxr_quality_spec_t qualitySpec = soxr_quality_spec(SOXR_MQ, SOXR_VR);
+  // Variable-rate mode expects the create-time ratio to cover the maximum
+  // later I/O ratio. Prime voices are 4-32 kHz; 64:1 leaves ample pitch room.
+  m_resampler = soxr_create(64.0, 1.0, 1, &error, &ioSpec, &qualitySpec, nullptr);
+  if (m_resampler == nullptr || error != nullptr) {
+    spdlog::error("SDLBackendVoice: soxr_create failed: {}", soxr_strerror(error));
+    m_resampler = nullptr;
+    return;
+  }
+  error = soxr_set_input_fn(m_resampler, SupplyResamplerInput, this, 4096);
+  if (error != nullptr) {
+    spdlog::error("SDLBackendVoice: soxr_set_input_fn failed: {}", soxr_strerror(error));
+    soxr_delete(m_resampler);
+    m_resampler = nullptr;
+    return;
+  }
+  updateResampleRatio(0);
+}
+
+SDLBackendVoice::~SDLBackendVoice() {
+  std::lock_guard<std::recursive_mutex> lock(m_root.m_lock);
+  if (m_resampler != nullptr) {
+    soxr_delete(m_resampler);
+    m_resampler = nullptr;
+  }
+  auto it = std::find(m_root.m_voices.begin(), m_root.m_voices.end(), this);
+  if (it != m_root.m_voices.end()) {
+    m_root.m_voices.erase(it);
+  }
+}
+
+size_t SDLBackendVoice::SupplyResamplerInput(void* state, soxr_in_t* data, size_t requested) {
+  auto* self = static_cast<SDLBackendVoice*>(state);
+  self->m_s16Buf.resize(requested);
+  const size_t supplied = self->m_clientVox.supplyAudio(requested, self->m_s16Buf.data());
+  *data = supplied != 0 ? self->m_s16Buf.data() : nullptr;
+  return supplied;
+}
+
+void SDLBackendVoice::updateResampleRatio(size_t slewFrames) {
+  if (m_resampler == nullptr) {
+    return;
+  }
+  const double effectiveRate = std::max(1.0, m_sourceRate * m_pitchRatio);
+  const soxr_error_t error = soxr_set_io_ratio(m_resampler, effectiveRate / m_root.m_mixRate, slewFrames);
+  if (error != nullptr) {
+    spdlog::warn("SDLBackendVoice: soxr_set_io_ratio({}) failed: {}", effectiveRate / m_root.m_mixRate,
+                 soxr_strerror(error));
+  }
+}
+
+void SDLBackendVoice::resetSampleRate(double sampleRate) {
+  std::lock_guard<std::recursive_mutex> lock(m_root.m_lock);
+  m_sourceRate = std::max(1.0, sampleRate);
+  if (!m_running && m_resampler != nullptr) {
+    soxr_clear(m_resampler);
+    updateResampleRatio(0);
+  }
+}
+
+void SDLBackendVoice::resetChannelLevels() {
+  std::lock_guard<std::recursive_mutex> lock(m_root.m_lock);
+  m_sends.clear();
+  m_root.m_submixesDirty = true;
+}
+
+void SDLBackendVoice::setChannelLevels(amuse::IBackendSubmix* submix, const std::array<float, 8>& coefs, bool slew) {
+  std::lock_guard<std::recursive_mutex> lock(m_root.m_lock);
+  auto* smx = static_cast<SDLBackendSubmix*>(submix);
+  if (smx == nullptr) {
+    smx = m_root.m_mainSubmix;
+  }
+  auto search = m_sends.find(smx);
+  if (search == m_sends.cend()) {
+    search = m_sends.emplace(smx, Send{}).first;
+    m_root.m_submixesDirty = true;
+  }
+  Send& send = search->second;
+  send.slewFrames = slew ? static_cast<int>(m_root.m_5msFrames) : 0;
+  send.curSlewFrame = 0;
+  send.oldCoefs = send.coefs;
+  send.coefs = coefs;
+}
+
+void SDLBackendVoice::setPitchRatio(double ratio, bool slew) {
+  std::lock_guard<std::recursive_mutex> lock(m_root.m_lock);
+  m_pitchRatio = std::clamp(ratio, 0.01, 16.0);
+  (void)slew;
+}
+
+void SDLBackendVoice::start() {
+  std::lock_guard<std::recursive_mutex> lock(m_root.m_lock);
+  m_running = true;
+}
+
+void SDLBackendVoice::stop() {
+  std::lock_guard<std::recursive_mutex> lock(m_root.m_lock);
+  m_running = false;
+}
+
+void SDLBackendVoice::pumpAndMix(size_t frames) {
+  if (m_scratchPre.size() < frames + 2) {
+    m_scratchPre.resize(frames + 2);
+  }
+  if (m_scratchPost.size() < frames + 2) {
+    m_scratchPost.resize(frames + 2);
+  }
+  const double dt = static_cast<double>(frames) / m_root.m_mixRate;
+  m_clientVox.preSupplyAudio(dt);
+
+  // Amuse may temporarily return zero while a logically running voice waits
+  // for data. SoXR treats that as permanent EOF, which left every gameplay
+  // voice running but silent. Restore the previously audible direct pull path
+  // until starvation and EOF can be signaled separately.
+  m_s16Buf.resize(frames);
+  const size_t oDone = m_clientVox.supplyAudio(frames, m_s16Buf.data());
+  for (size_t i = 0; i < oDone; ++i) {
+    m_scratchPre[i] = static_cast<float>(m_s16Buf[i]) / 32768.f;
+  }
+  std::fill(m_scratchPre.begin() + static_cast<std::ptrdiff_t>(oDone),
+            m_scratchPre.begin() + static_cast<std::ptrdiff_t>(frames), 0.f);
+
+  if (m_sends.empty()) {
+    // Route to the main output with an identity-ish stereo matrix (FL=FR=1).
+    SDLBackendSubmix& mainSmx = *m_root.m_mainSubmix;
+    m_clientVox.routeAudio(oDone, dt, mainSmx.m_busId, m_scratchPre.data(), m_scratchPost.data());
+    float* out = mainSmx.getMergeBuf(oDone);
+    for (size_t f = 0; f < oDone; ++f) {
+      const float v = m_scratchPost[f];
+      out[f * kChannelCount + 0] += v;
+      out[f * kChannelCount + 1] += v;
+    }
+  } else {
+    for (auto& kv : m_sends) {
+      SDLBackendSubmix* smx = kv.first;
+      Send& send = kv.second;
+      m_clientVox.routeAudio(oDone, dt, smx->m_busId, m_scratchPre.data(), m_scratchPost.data());
+      float* out = smx->getMergeBuf(oDone);
+      const bool slewing = send.slewFrames != 0 && send.curSlewFrame < send.slewFrames;
+      for (size_t f = 0; f < oDone; ++f) {
+        const float v = m_scratchPost[f];
+        float gain[2];
+        if (slewing) {
+          const double t = static_cast<double>(send.curSlewFrame) / static_cast<double>(send.slewFrames);
+          const double omt = 1.0 - t;
+          gain[0] = static_cast<float>(send.coefs[0] * t + send.oldCoefs[0] * omt);
+          gain[1] = static_cast<float>(send.coefs[1] * t + send.oldCoefs[1] * omt);
+        } else {
+          gain[0] = send.coefs[0];
+          gain[1] = send.coefs[1];
+        }
+        out[f * kChannelCount + 0] += v * gain[0];
+        out[f * kChannelCount + 1] += v * gain[1];
+      }
+      if (slewing) {
+        ++send.curSlewFrame;
+      }
+    }
+  }
+}
+
+SDLBackendSubmix::SDLBackendSubmix(SDLBackendVoiceAllocator& root, amuse::Submix* clientSmx, bool mainOut, int busId)
+: m_root(root), m_clientSmx(clientSmx), m_busId(busId), m_mainOut(mainOut) {
+  if (mainOut && this != m_root.m_mainSubmix) {
+    // Route to the allocator's main output at unity.
+    setSendLevel(m_root.m_mainSubmix, 1.f, false);
+  }
+}
+
+SDLBackendSubmix::~SDLBackendSubmix() {
+  std::lock_guard<std::recursive_mutex> lock(m_root.m_lock);
+  auto it = std::find(m_root.m_submixes.begin(), m_root.m_submixes.end(), this);
+  if (it != m_root.m_submixes.end()) {
+    m_root.m_submixes.erase(it);
+  }
+  m_root.m_submixesDirty = true;
+}
+
+void SDLBackendSubmix::setSendLevel(amuse::IBackendSubmix* submix, float level, bool slew) {
+  std::lock_guard<std::recursive_mutex> lock(m_root.m_lock);
+  auto* smx = static_cast<SDLBackendSubmix*>(submix);
+  if (smx == nullptr) {
+    smx = m_root.m_mainSubmix;
+  }
+  auto search = m_sendGains.find(smx);
+  if (search == m_sendGains.cend()) {
+    search = m_sendGains.emplace(smx, std::array<float, 2>{1.f, 1.f}).first;
+    m_root.m_submixesDirty = true;
+  }
+  m_slewFrames = slew ? static_cast<int>(m_root.m_5msFrames) : 0;
+  m_curSlewFrame = 0;
+  search->second[0] = search->second[1];
+  search->second[1] = level;
+}
+
+double SDLBackendSubmix::getSampleRate() const { return m_root.m_mixRate; }
+
+amuse::SubmixFormat SDLBackendSubmix::getSampleFormat() const { return amuse::SubmixFormat::Float; }
+
+void SDLBackendSubmix::zeroFill() {
+  if (!m_scratch.empty()) {
+    std::fill(m_scratch.begin(), m_scratch.end(), 0.f);
+  }
+}
+
+float* SDLBackendSubmix::getMergeBuf(size_t frames) {
+  if (m_redirect) {
+    return m_redirect;
+  }
+  const size_t sampleCount = frames * kChannelCount;
+  if (m_scratch.size() < sampleCount) {
+    m_scratch.resize(sampleCount);
+  }
+  return m_scratch.data();
+}
+
+bool SDLBackendSubmix::isDirectDependencyOf(SDLBackendSubmix* send) const {
+  return m_sendGains.find(send) != m_sendGains.cend();
+}
+
+void SDLBackendSubmix::linearizeC3(std::vector<SDLBackendSubmix*>& out) {
+  // Simple iterative C3 merge over the allocator's submix list.
+  out.push_back(this);
+  bool changed = true;
+  while (changed) {
+    changed = false;
+    for (SDLBackendSubmix* smx : m_root.m_submixes) {
+      if (smx == this || std::find(out.begin(), out.end(), smx) != out.end()) {
+        continue;
+      }
+      if (smx->isDirectDependencyOf(this)) {
+        out.push_back(smx);
+        changed = true;
+      }
+    }
+  }
+}
+
+void SDLBackendSubmix::pumpAndMix(size_t frames) {
+  const int chanCount = kChannelCount;
+
+  if (m_redirect) {
+    if (m_clientSmx != nullptr && m_clientSmx->canApplyEffect()) {
+      amuse::ChannelMap chMap;
+      chMap.m_channelCount = 2;
+      chMap.m_channels[0] = amuse::AudioChannel::FrontLeft;
+      chMap.m_channels[1] = amuse::AudioChannel::FrontRight;
+      m_clientSmx->applyEffect(m_redirect, frames, chMap);
+    }
+    m_redirect += chanCount * frames;
+  } else {
+    const size_t sampleCount = frames * chanCount;
+    if (m_scratch.size() < sampleCount) {
+      m_scratch.resize(sampleCount);
+    }
+    if (m_clientSmx != nullptr && m_clientSmx->canApplyEffect()) {
+      amuse::ChannelMap chMap;
+      chMap.m_channelCount = 2;
+      chMap.m_channels[0] = amuse::AudioChannel::FrontLeft;
+      chMap.m_channels[1] = amuse::AudioChannel::FrontRight;
+      m_clientSmx->applyEffect(m_scratch.data(), frames, chMap);
+    }
+
+    for (auto& kv : m_sendGains) {
+      SDLBackendSubmix* sm = kv.first;
+      float* dataOut = sm->getMergeBuf(frames);
+      const bool slewing = m_slewFrames != 0 && m_curSlewFrame < m_slewFrames;
+      for (size_t f = 0; f < sampleCount; ++f) {
+        const float v = m_scratch[f];
+        if (slewing) {
+          const double t = static_cast<double>(m_curSlewFrame) / static_cast<double>(m_slewFrames);
+          const double omt = 1.0 - t;
+          dataOut[f] += v * static_cast<float>(kv.second[1] * t + kv.second[0] * omt);
+        } else {
+          dataOut[f] += v * kv.second[1];
+        }
+      }
+      if (slewing) {
+        ++m_curSlewFrame;
+      }
+    }
+  }
+}
+
+} // namespace metaforce

 CAudioSys* CAudioSys::g_SharedSys = nullptr;
+SDLBackendVoiceAllocator* CAudioSys::s_audioBackend = nullptr;
+amuse::Engine* CAudioSys::s_amuseEngine = nullptr;
+
+namespace {
+struct SourceStats {
+  float peak = 0.f;
+  std::array<float, 2> previous{};
+  uint64_t jumps = 0;
+  std::array<bool, 2> hasPrevious{};
+
+  void add(const float* samples, size_t sampleCount) {
+    for (size_t i = 0; i < sampleCount; ++i) {
+      const float sample = samples[i];
+      const size_t channel = i & 1;
+      peak = std::max(peak, std::abs(sample));
+      if (hasPrevious[channel] && std::abs(sample - previous[channel]) > 0.5f) {
+        ++jumps;
+      }
+      previous[channel] = sample;
+      hasPrevious[channel] = true;
+    }
+  }
+
+  void resetInterval() {
+    peak = 0.f;
+    jumps = 0;
+  }
+};
+
+void LimitPeak(float* samples, size_t sampleCount, float knee, float ceiling) {
+  const float headroom = ceiling - knee;
+  for (size_t i = 0; i < sampleCount; ++i) {
+    const float magnitude = std::abs(samples[i]);
+    if (magnitude > knee) {
+      const float limited = knee + headroom * std::tanh((magnitude - knee) / headroom);
+      samples[i] = std::copysign(limited, samples[i]);
+    }
+  }
+}
+
+void MasterSupplyCallback(float* data, int frames) {
+  static std::vector<float> frontendBuf;
+  static std::vector<float> amuseBuf;
+  static std::vector<float> streamBuf;
+  static SourceStats frontendStats;
+  static SourceStats amuseStats;
+  static SourceStats streamStats;
+  static SourceStats outputStats;
+  static uint64_t callbackCount = 0;
+
+  const size_t sampleCount = static_cast<size_t>(frames) * 2;
+  frontendBuf.resize(sampleCount);
+  amuseBuf.assign(sampleCount, 0.f);
+  streamBuf.assign(sampleCount, 0.f);
+
+  CStaticAudioPlayer::SupplyCallback(frontendBuf.data(), frames);
+  if (SDLBackendVoiceAllocator* backend = CAudioSys::GetAudioBackendPtr()) {
+    backend->pumpAndMix(static_cast<size_t>(frames), amuseBuf.data());
+  }
+  CStreamAudioManager::SupplyCallback(streamBuf.data(), frames);
+  for (size_t i = 0; i < sampleCount; ++i) {
+    data[i] = frontendBuf[i] + amuseBuf[i] + streamBuf[i];
+  }
+  // Individual sources may be in range while their sum clips. Smooth only
+  // final-mix peaks above the knee and leave normal-level samples unchanged.
+  LimitPeak(data, sampleCount, 0.8f, 0.95f);
+
+  frontendStats.add(frontendBuf.data(), sampleCount);
+  amuseStats.add(amuseBuf.data(), sampleCount);
+  streamStats.add(streamBuf.data(), sampleCount);
+  outputStats.add(data, sampleCount);
+
+  if (++callbackCount % 300 == 0) {
+    size_t totalVoices = 0;
+    size_t runningVoices = 0;
+    if (SDLBackendVoiceAllocator* backend = CAudioSys::GetAudioBackendPtr()) {
+      backend->getVoiceCounts(totalVoices, runningVoices);
+    }
+    aurora_audio_log_mix_sources(frontendStats.peak, amuseStats.peak, streamStats.peak,
+                                 outputStats.peak, frontendStats.jumps, amuseStats.jumps,
+                                 streamStats.jumps, totalVoices, runningVoices,
+                                 CStreamAudioManager::GetActiveStreamCount());
+    frontendStats.resetInterval();
+    amuseStats.resetInterval();
+    streamStats.resetInterval();
+    outputStats.resetInterval();
+  }
+}
+} // namespace
+
+amuse::Engine& CAudioSys::GetAmuseEngine() {
+  if (s_amuseEngine == nullptr) {
+    AudioSysInit();
+  }
+  return *s_amuseEngine;
+}
+
+SDLBackendVoiceAllocator& CAudioSys::GetAudioBackend() {
+  GetAmuseEngine();
+  return *s_audioBackend;
+}
+
+SDLBackendVoiceAllocator* CAudioSys::GetAudioBackendPtr() { return s_audioBackend; }
+
+void CAudioSys::AudioSysInit() {
+  if (s_amuseEngine != nullptr) {
+    return;
+  }
+  s_audioBackend = new SDLBackendVoiceAllocator(32000.0);
+  s_amuseEngine = new amuse::Engine(*s_audioBackend);
+  aurora_audio_open(32000, MasterSupplyCallback);
+  spdlog::info("CAudioSys: amuse engine initialized (SDL backend, 32000 Hz)");
+}
+
+void CAudioSys::AudioSysShutdown() {
+  delete s_amuseEngine;
+  s_amuseEngine = nullptr;
+  delete s_audioBackend;
+  s_audioBackend = nullptr;
+}
 

 void CAudioSys::SysRemoveGroupFromAmuse(std::string_view name) {
+  auto set = FindGroupSet(name);
+  if (!set) {
+    return;
+  }
+  if (s_amuseEngine != nullptr) {
+    s_amuseEngine->removeAudioGroup(set->GetAudioGroupData());
+  }
+  spdlog::info("CAudioSys: removed audio group '{}' from amuse", name);
 }
 

+  std::lock_guard<std::recursive_mutex> lock(m_lock);
+  std::unique_ptr<SDLBackendSubmix> ret = std::make_unique<SDLBackendSubmix>(*this, &clientSmx, mainOut, busId);
+  m_submixes.push_back(ret.get());
+  m_submixesDirty = true;
+  return ret;
+}

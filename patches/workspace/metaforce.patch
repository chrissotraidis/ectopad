+void CStreamAudioManager::SupplyCallback(float* data, int frames) {
+  if (data == nullptr || frames <= 0) {
+    return;
+  }
+
+  std::vector<int16_t> pcm(static_cast<size_t>(frames));
+  for (auto& stream : SDSPStream::g_Streams) {
+    if (!stream.x0_active || stream.xe8_silent || !stream.xd4_ringBuffer) {
+      continue;
+    }
+    std::fill(pcm.begin(), pcm.end(), 0);
+    int16_t* out = pcm.data();
+    stream.supplyAudio(static_cast<size_t>(frames), out);
+    const float left = stream.m_leftgain * stream.x4c_vol;
+    const float right = stream.m_rightgain * stream.x4c_vol;
+    for (int i = 0; i < frames; ++i) {
+      const float sample = pcm[static_cast<size_t>(i)] / 32768.f;
+      data[i * 2] += sample * left;
+      data[i * 2 + 1] += sample * right;
+    }
+  }
+}

+- (void)reportProblem {
+    UIViewController *presenter = self.window.rootViewController;
+    UIAlertController *prompt =
+        [UIAlertController alertControllerWithTitle:@"Report a Problem"
+                                            message:@"Export the diagnostic log, then attach it to a GitHub report along with a screenshot if the problem is visual. The log can include your iOS version, display and controller details, game-image filename, app-container paths, and runtime errors. It never includes the game image, extracted files, or saves. GitHub reports and attachments are public."
+                                     preferredStyle:UIAlertControllerStyleAlert];
+    [prompt addAction:[UIAlertAction actionWithTitle:@"Cancel"
+                                                style:UIAlertActionStyleCancel
+                                              handler:nil]];
+    __weak SunPadGameOverlay *weakSelf = self;
+    [prompt addAction:[UIAlertAction actionWithTitle:@"Export Diagnostic Log…"
+                                                style:UIAlertActionStyleDefault
+                                              handler:^(UIAlertAction *action) {
+        (void)action;
+        [weakSelf presentDiagnosticLogShareSheet];
+    }]];
+    [prompt addAction:[UIAlertAction actionWithTitle:@"Report on GitHub"
+                                                style:UIAlertActionStyleDefault
+                                              handler:^(UIAlertAction *action) {
+        (void)action;
+        NSURL *url = [NSURL URLWithString:
+            @"https://github.com/chrissotraidis/ectopad/issues/new"];
+        if (url != nil) {
+            [UIApplication.sharedApplication openURL:url options:@{}
+                                   completionHandler:^(BOOL success) {
+                if (!success)
+                    SunPadLog(@"diagnostic github open failed");
+            }];
+        }
+    }]];
+    prompt.preferredAction = prompt.actions.lastObject;
+    [presenter presentViewController:prompt animated:YES completion:nil];
+}

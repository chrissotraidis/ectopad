+      status.analogA = 255;
+    }
+    if (status.button & PAD_BUTTON_B) {
+      status.analogB = 255;
+    }
+    PADSetVirtualStatus(0, &status);
+    return;
+  }
+  PADClearVirtualStatus(0);
+}

+- (UIAction *)renderAction:(NSString *)title scale:(NSInteger)scale {
+    __weak SunPadGameOverlay *weakSelf = self;
+    UIAction *renderAction = [UIAction actionWithTitle:title
+                                                 image:nil
+                                            identifier:nil
+                                               handler:^(__kindof UIAction *action) {

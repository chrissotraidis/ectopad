+- (UIView *)hitTest:(CGPoint)point withEvent:(UIEvent *)event {
+    UIView *hit = [super hitTest:point withEvent:event];
+    for (UIView *view = hit; view != nil && view != self; view = view.superview) {
+        if ([view isKindOfClass:UIControl.class])
+            return hit;
+    }
+    return nil;
+}

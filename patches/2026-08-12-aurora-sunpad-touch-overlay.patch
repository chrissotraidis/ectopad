+  if (haveTouch) {
+    status.err = PAD_ERR_NONE;
+    status.stickX = touchState.stickX;
+    status.stickY = touchState.stickY;
+    status.substickX = touchState.cStickX;
+    status.substickY = touchState.cStickY;
+    status.triggerLeft = touchState.triggerL;
+    status.triggerRight = touchState.triggerR;

+
+void CStaticAudioPlayer::StartMixing() {
+  s_activePlayer = this;
+  x18_curSamp = 0;
+  g72x_init_state(&x58_leftState);
+  g72x_init_state(&x8c_rightState);
+  m_leftStateLoop.reset();
+  m_rightStateLoop.reset();
+}
+
+void CStaticAudioPlayer::StopMixing() {
+  if (s_activePlayer == this) {
+    s_activePlayer = nullptr;
+  }
+}
+
+void CStaticAudioPlayer::SupplyCallback(float* data, int frames) {
+  CStaticAudioPlayer* self = s_activePlayer;
+  if (self == nullptr) {
+    aurora_audio_fill_silence(data, frames);
+    return;
+  }
+  if (!self->IsReady()) {
+    aurora_audio_fill_silence(data, frames);
+    return;
+  }
+  self->x38_dvdRequests.clear();
+  std::vector<s16> tmp(static_cast<size_t>(frames) * 2);
+  self->Decode(tmp.data(), frames);
+  for (int i = 0; i < frames * 2; ++i) {
+    data[i] = tmp[static_cast<size_t>(i)] / 32768.f;
+  }
+}
 

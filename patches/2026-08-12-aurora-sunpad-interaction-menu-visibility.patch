+static UIView* FindView(UIView* root, NSString* accessibilityLabel,
+                        NSString* accessibilityIdentifier) {
+    const BOOL labelMatches = accessibilityLabel == nil ||
+        [root.accessibilityLabel isEqualToString:accessibilityLabel];
+    const BOOL identifierMatches = accessibilityIdentifier == nil ||
+        [root.accessibilityIdentifier isEqualToString:accessibilityIdentifier];
+    if (labelMatches && identifierMatches)
+        return root;
+    for (UIView* child in root.subviews) {
+        UIView* match = FindView(child, accessibilityLabel, accessibilityIdentifier);
+        if (match != nil)
+            return match;
+    }
+    return nil;
+}
+
+static UIView* FindViewOfClass(UIView* root, Class expectedClass,
+                               NSString* accessibilityLabel,
+                               NSString* accessibilityIdentifier) {
+    UIView* match = FindView(root, accessibilityLabel, accessibilityIdentifier);
+    if ([match isKindOfClass:expectedClass])
+        return match;
+    for (UIView* child in root.subviews) {
+        match = FindViewOfClass(child, expectedClass, accessibilityLabel,
+                                accessibilityIdentifier);
+        if (match != nil)
+            return match;
+    }
+    return nil;
+}
+
+static void CollectMenuTitles(UIMenuElement* element, NSMutableSet<NSString*>* titles) {
+    if (element.title.length > 0)
+        [titles addObject:element.title];
+    if ([element isKindOfClass:UIMenu.class]) {
+        for (UIMenuElement* child in ((UIMenu*)element).children)
+            CollectMenuTitles(child, titles);
+    }
+}
+
+static NSDictionary<NSString*, id>* SaveDefaults(NSArray<NSString*>* keys) {
+    NSMutableDictionary<NSString*, id>* saved = [NSMutableDictionary dictionary];
+    NSUserDefaults* defaults = NSUserDefaults.standardUserDefaults;
+    for (NSString* key in keys) {
+        id value = [defaults objectForKey:key];
+        saved[key] = value ?: NSNull.null;
+    }
+    return saved;
+}
+
+static void RestoreDefaults(NSDictionary<NSString*, id>* saved) {
+    NSUserDefaults* defaults = NSUserDefaults.standardUserDefaults;
+    for (NSString* key in saved) {
+        id value = saved[key];
+        if (value == NSNull.null)
+            [defaults removeObjectForKey:key];
+        else
+            [defaults setObject:value forKey:key];
+    }
+    [defaults synchronize];
+
+    SunPadSettings* settings = SunPadSettings.sharedSettings;
+    [settings resetControlSizeScales];
+    NSDictionary<NSString*, NSNumber*>* sizes = saved[@"SunPadControlSizeScales"];
+    if ([sizes isKindOfClass:NSDictionary.class]) {
+        for (NSString* identifier in sizes)
+            [settings setSizeScale:sizes[identifier].doubleValue forControl:identifier];
+    }
+    [settings synchronize];
+}

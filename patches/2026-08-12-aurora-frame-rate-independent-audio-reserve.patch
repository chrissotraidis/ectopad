+    Log.info("Audio pump: {} input frames supplied, availableOutputFrames={} targetOutputFrames={} underruns={}",
+             frames, SDL_GetAudioStreamAvailable(g_stream) / g_outputBytesPerFrame,
+             targetOutputFrames, g_underrunCount);

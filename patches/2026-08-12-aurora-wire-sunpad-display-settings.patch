 /* Delegate for the SunPad overlay's menu actions that touch game data or
  * controller mapping. Wired to the shared app services as they land; for now
  * they surface a "coming soon" alert so the menu stays fully navigable. */
 @interface TouchOverlayDelegate : NSObject <SunPadGameOverlayDelegate>
 - (void)presentComingSoon:(SunPadGameOverlay*)overlay title:(NSString*)title;
+- (void)applyEngineSettings;
 @end
 
 @implementation TouchOverlayDelegate
 
+- (instancetype)init {
+    if ((self = [super init])) {
+        [[NSNotificationCenter defaultCenter] addObserver:self
+                                                 selector:@selector(settingsChanged:)
+                                                     name:NSUserDefaultsDidChangeNotification
+                                                   object:nil];
+    }
+    return self;
+}
+
+- (void)dealloc {
+    [[NSNotificationCenter defaultCenter] removeObserver:self];
+}
+
+- (void)settingsChanged:(NSNotification*)notification {
+    (void)notification;
+    [self applyEngineSettings];
+}
+
+- (void)applyEngineSettings {
+    SunPadSettings* settings = [SunPadSettings sharedSettings];
+    aurora::window::set_frame_buffer_scale(settings.renderScaleFloat);
+    switch (settings.aspectRatioMode) {
+    case SunPadAspectRatioWidescreen:
+        aurora::window::set_frame_buffer_aspect_ratio(16.f / 9.f);
+        break;
+    case SunPadAspectRatioFillScreen:
+        aurora::window::set_frame_buffer_aspect_ratio(0.f);
+        break;
+    case SunPadAspectRatioOriginal:
+    default:
+        aurora::window::set_frame_buffer_aspect_ratio(4.f / 3.f);
+        break;
+    }
+    SunPadLog(@"engine settings renderScale=%ld aspectMode=%ld",
+              (long)settings.renderScale, (long)settings.aspectRatioMode);
+}

+#pragma once
+
+#include <cstdint>
+
+struct PADStatus;
+
+namespace aurora::touch {
+
+/* SDL finger events (normalized x/y in [0,1]) feed a Prime-native touch overlay
+ * that drives the GameCube pad on port 0 through the virtual-status mechanism.
+ * Coordinates come straight from SDL_EVENT_FINGER_* (tfinger.x/.y). */
+void finger_down(uint64_t fingerId, float x, float y);
+void finger_motion(uint64_t fingerId, float x, float y);
+void finger_up(uint64_t fingerId);
+
+/* Called by the pad layer once per PADRead. Fills `out` with the merged virtual
+ * pad state (sticks, D-pad, buttons, triggers) and returns true when any touch
+ * control is currently active; returns false (and the caller should clear the
+ * virtual pad) when idle or when touch is unsupported. */
+bool get_status(PADStatus& out);
+
+/* Draws the overlay on top of the game. Must be called while an ImGui frame is
+ * active (the aurora imgui freeze() path does this). */
+void render();
+
+/* Customization. */
+void toggle_edit_mode();
+void reset_layout();
+void save_layout();
+void shutdown();
+
+} // namespace aurora::touch
